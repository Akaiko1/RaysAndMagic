//include standee_sampling.kageinc
//include standee_end_wall.kageinc
//include gold_reflection.kageinc

// Surfaces by name: the standeeLayer* constants in render_standee.go;
// TestShaderConstantsMatchGo keeps the values equal.
const (
	standeeLayerNearSticker = 0
	standeeLayerCore = 1
	standeeLayerFarSticker = 2
	standeeLayerEndWall = 3
)

func Fragment(rawDstPos vec4, srcPos vec2, color vec4, custom vec4) vec4 {
	dstPos := vec4(paniniSourcePoint(rawDstPos.xy-imageDstOrigin())+imageDstOrigin(),rawDstPos.zw)
	p := srcPos
	data := custom
	if data.z < 0.0 {
		// Wide strips carry affine reciprocal depth and U/depth, plus the
		// projected top and height. Reconstruct perspective at the pixel centre.
		projection := p - imageSrc0Origin()
		u := clamp(data.y/data.x, 0.0, 1.0)
		v := (dstPos.y-imageDstOrigin().y-projection.x)/projection.y
		p = standeeSourcePosition(u, v)
		packed := -data.z-1.0
		layer := floor(packed/4.0)
		filterData := packed-4.0*layer
		filtered := floor(filterData/2.0)
		blend := clamp((filterData-2.0*filtered-0.25)*2.0, 0.0, 1.0)
		data = vec4(blend, layer, filtered, data.w)
	}
	// Art rows per screen pixel, taken before the surface branches return.
	rowsPerPixel := length(vec2(dfdx(p.y), dfdy(p.y)))
	// data.y selects the surface. data.w carries the art's horizontal scale,
	// texels per screen pixel; the rows give the vertical one, and the larger
	// is the major axis.
	surface := floor(data.y + .5) // an exact id, safe from interpolation error
	if surface == standeeLayerFarSticker {
		return goldReflection(stickerAt(p, data.x), goldSide(dstPos.x-imageDstOrigin().x), standeeFrameUV(p).y) * color
	}
	if surface == standeeLayerCore {
		return sampleLinear3(p) * color
	}
	if surface == standeeLayerEndWall {
		// The vertices carry the core tone; the geometry, the wall's rows.
		g := standeeEndWallGrain(p.y-imageSrc0Origin().y, rowsPerPixel)
		return vec4(g, g, g, 1) * color
	}
	scale := vec2(data.w, rowsPerPixel)
	footprint := vec2(scale.x, 0)
	if scale.y > scale.x {
		footprint = vec2(0, scale.y)
	}
	return goldReflection(nearStickerAt(p, data.z > 0.0, data.x, footprint, scale), goldSide(dstPos.x-imageDstOrigin().x), standeeFrameUV(p).y) * color
}

//include panini.kageinc
