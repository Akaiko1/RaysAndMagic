//kage:unit pixels
package main

//include weapon_noise.kageinc

var Time float
var Viewport vec3
var CameraForward vec3

// Smooth slices of the shared noise field form a continuous 3D density.
// The Z slices are independently offset, rather than projecting Z into XY.
func campNoiseSlice(p vec2) float {
    size := imageSrc1Size()
    q := mod(p*32.0,size)
    cell, f := floor(q), fract(q)
    origin := imageSrc0Origin()+vec2(.5)
    a := imageSrc1UnsafeAt(origin+mod(cell,size)).r
    b := imageSrc1UnsafeAt(origin+mod(cell+vec2(1,0),size)).r
    c := imageSrc1UnsafeAt(origin+mod(cell+vec2(0,1),size)).r
    d := imageSrc1UnsafeAt(origin+mod(cell+vec2(1,1),size)).r
    return mix(mix(a,b,f.x),mix(c,d,f.x),f.y)
}

func campNoise(p vec3) float {
    z := floor(p.z)
    f := fract(p.z)
    f = f*f*(3.0-2.0*f)
    return mix(campNoiseSlice(p.xy+z*vec2(2.31,3.73)),
        campNoiseSlice(p.xy+(z+1.0)*vec2(2.31,3.73)),f)
}

func campFlame(entry, eye vec3, heat, clock, scale, depth, wallDepth, wallTop, screenY float) vec4 {
    ray := normalize(entry-eye)
    accum := vec4(0)
    // Small fixed volume, deterministic sampling, no frame-random grain.
    for i:=0; i<32; i++ {
        t := (float(i)+.5)*.03125
        p := entry+ray*t
        if abs(p.x)>.331 || abs(p.y)>.331 || p.z<.17 || p.z>1.0 { break }
        sampleDepth := depth + t*scale*CameraForward.z*dot(ray.xy,CameraForward.xy)
        if screenY>=wallTop && sampleDepth>wallDepth+.07 { break }
        h := (p.z-.17)/.83
        // Upward advection drives both the broad curl and smaller licking edges.
        flow := vec3(p.xy*7.0,h*2.6-clock*1.7)
        curl := campNoise(flow*.62+vec3(0,0,clock*.24))-.5
        bent := p.xy + vec2(curl,sin(h*5.0-clock*2.1)*.28)*h*.22
        n := campNoise(vec3(bent*13.0,h*4.2-clock*2.8))
        detail := campNoise(vec3(bent*26.0+9.0,h*8.0-clock*4.3))
        turbulence := (n-.5)*.22+(detail-.5)*.055
        // A broad hot root splits into narrow, curling tongues as it rises.
        radius := length(bent)
        profile := .245*(1.0-h)*(1.0-h*.22)*sqrt(heat)
        field := profile-radius + turbulence*(.35+h*1.3)
        density := smoothstep(-.015,.060,field)*(1.0-smoothstep(.83,1.0,h))*heat
        a := 1.0-exp(-density*.30)
        temperature := clamp(field*5.0+(1.0-h)*.48,0.0,1.0)
        rgb := mix(vec3(1.0,.075,.003),vec3(1.0,.47,.015),smoothstep(.02,.40,temperature))
        rgb = mix(rgb,vec3(1.0,.94,.57),smoothstep(.32,.85,temperature))
        accum += vec4(rgb*a,a)*(1.0-accum.a)
        if accum.a>.985 { break }
    }
    return accum
}

// Geometry supplies lit normals, specular response and reciprocal world depth.
// Surface coordinates are divided by depth at each vertex, then reconstructed
// here, so scratches and glyphs follow the tile instead of stretching in screen space.
func Fragment(rawDst vec4, src vec2, color vec4, custom vec4) vec4 {
	dst := vec4(paniniSourcePoint(rawDst.xy-imageDstOrigin())+imageDstOrigin(),rawDst.zw)
	q := max(custom.z, 0.000001)
	// Paired with the 1024 coordinate scale in render_world_mesh.go.
	p := (src - imageSrc0Origin()) / (q * 1024.0)
	pixel := dst.xy - imageDstOrigin()
	wall := imageSrc0UnsafeAt(imageSrc0Origin() + vec2(floor(pixel.x)+0.5, 0.5))
	wallDepth := (wall.r*65280.0 + wall.g*255.0) / 65535.0 * Viewport.z
	top := imageSrc0UnsafeAt(imageSrc0Origin() + vec2(floor(pixel.x)+0.5, 1.5))
	wallTop := (top.r*65280.0 + top.g*255.0) / 65535.0 * Viewport.y
	if 1.0/q > wallDepth+0.07 && pixel.y >= wallTop {
		discard()
	}
	mat := floor(custom.w)
    if mat == 10.0 {
        scale := color.a
        entry := vec3(p,custom.x/q)/scale
        return campFlame(entry,color.rgb/scale,custom.y,Time+fract(custom.w)*13.0,
            scale,1.0/q,wallDepth,wallTop,pixel.y)
    }
	grain := fxNoise(p*230.0) * .08
	shade, spec := custom.x, custom.y
	rgb := color.rgb * (shade + grain)
	a := color.a
	if mat < 3.0 {
		scratches := pow(max(0.0, sin(p.x*170.0+p.y*8.0)), 18.0) * .08
		rgb += vec3(spec*.8 + scratches)
	} else if mat == 3.0 {
		// Cyan glass: transparent faces with restrained reflected highlights.
		rib := pow(max(0.0, sin(p.x*25.0+p.y*4.0)), 20.0)
		rgb = color.rgb * (.55 + spec*2.0 + rib*.2)
		a *= .24 + spec*.55 + rib*.14
	} else if mat == 4.0 {
		// The hourglass sand and the lit seams stay coherent on their surfaces.
		flow := .7 + .3*sin(p.y*115.0-Time*6.0)
		rgb = color.rgb * (.8 + flow*.5)
	} else if mat == 5.0 {
		rgb = color.rgb * (.8 + .2*sin(p.x*15.0+p.y*9.0-Time*1.5))
	} else if mat == 6.0 {
		coal := fxNoise(p * 38.0)
		heat := smoothstep(.48, .76, coal+.06*sin(Time*2.0+p.x*13.0))
		rgb = mix(vec3(.045, .023, .018), color.rgb*1.3, heat)
	} else if mat == 7.0 {
		// A world-oriented plume surface with advecting tongues and transparent gaps.
		f := vec2(p.x*11.0, p.y*7.0-Time*2.0)
		n := fxNoise(f + vec2(fxNoise(f*.5)*1.7, 0))
		edge := 1.0 - smoothstep(.4, .95, abs(p.x)/mix(.5, .225, p.y))
		density := (1.0-p.y)*.72 + n*.55 - abs(p.x)*1.7 - .17
		a *= edge * smoothstep(.01, .24, density) * (1.0 - smoothstep(.65, 1.0, p.y))
		rgb = mix(vec3(.8, .055, .008), vec3(1.0, .85, .28), clamp(density*1.9, 0.0, 1.0))
	}
    if mat == 8.0 {
        // Long grain, knots and narrow plank joints belong to the wood surface.
        grain = fxNoise(vec2(p.x*19.0,p.y*2.2))
        rings := sin(p.x*185.0 + sin(p.y*7.0)*1.8 + grain*5.0)
        seams := smoothstep(.94,1.0,abs(sin(p.x*31.4)))
        rgb = color.rgb*(shade*(.79+grain*.26+rings*.045))*(1.0-seams*.35)
    } else if mat == 9.0 {
        grain = fxNoise(p*85.0)
        rgb = color.rgb*shade*(.73+grain*.44)
    } else if mat == 11.0 {
        // Dry plaster: broad restrained mottling, no metallic scratches or
        // high-contrast stone grain on the guild's timber infill panels.
        rgb = color.rgb*shade*(.94+fxNoise(p*17.0)*.09)
    } else if mat == 12.0 {
        // Warm interior light behind the opaque window leadwork.
        rgb = color.rgb*(.77+fxNoise(p*28.0)*.18)
    }
    return vec4(rgb*a, a)
}

//include panini.kageinc
