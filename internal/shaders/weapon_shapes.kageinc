// Shape distances share a pixel-sized antialias fringe. Layering never samples
// icon art: every edge, material break and fitting is procedural.
func box(p, b vec2) float { q := abs(p) - b; return length(max(q, vec2(0))) + min(max(q.x, q.y), 0) }
func triangle(p, a, b, c vec2) float {
	ab, bc, ca := b-a, c-b, a-c
	sign := 1.0
	if ab.x*(c-a).y-ab.y*(c-a).x < 0 {
		sign = -1.0
	}
	da := sign * ((p-a).x*ab.y - (p-a).y*ab.x) / length(ab)
	db := sign * ((p-b).x*bc.y - (p-b).y*bc.x) / length(bc)
	dc := sign * ((p-c).x*ca.y - (p-c).y*ca.x) / length(ca)
	return max(da, max(db, dc))
}
func capsule(p, a, b vec2, r float) float {
	q := p - a
	v := b - a
	return length(q-v*clamp(dot(q, v)/dot(v, v), 0, 1)) - r
}
func coat(dst vec4, d float, c vec3, p vec2, aa float) vec4 {
	a := 1.0 - smoothstep(-aa, aa, d)
	// Dark outside bevel, narrow inner light: still legible at gameplay scale.
	bevel := smoothstep(-.035, -.009, d)
	c *= mix(1.0, .48, bevel)
	return mix(dst, vec4(c, 1), a)
}
func metal(p vec2, c vec3) vec3 {
	return c * (.60 + .55*step(p.y, 0) + .22*exp(-p.y*p.y*160))
}
func haft(out vec4, p vec2, start, end, width float, c vec3, aa float) vec4 {
	d := box(p-vec2((start+end)*.5, 0), vec2((end-start)*.5, width))
	wrap := .72 + .28*smoothstep(.15, .4, fract((p.x+p.y*.7)*8))
	return coat(out, d, c*wrap*(.8+.3*step(p.y, 0)), p, aa)
}
func ring(out vec4, p, center vec2, r, w float, c vec3, aa float) vec4 {
	return coat(out, abs(length(p-center)-r)-w, c, p, aa)
}
func macheteBody(p vec2, aa float) vec4 {
	// Broad chopping belly, narrow heel and swept point; the lower edge leads.
	u := clamp((p.x+2.85)/2.85, 0, 1)
	spine := -.06*(1-u) - .24*pow(u, .9)*sin(3.14159*u)
	belly := .10*(1-u) + .95*pow(u, 1.6)*sqrt(1-u)
	d := max(max(spine-p.y, p.y-belly), max(-2.85-p.x, p.x))
	steel, gold := vec3(.32, .30, .26), vec3(.68, .46, .16)
	grain := .93 + .07*sin(p.x*67+p.y*31)*sin(p.y*83)
	out := coat(vec4(0), d, steel*grain*(.85+.30*u), p, aa)
	// A broad ground bevel distinguishes the cutting edge from the dark back.
	bevel := max(d, belly-p.y-.055)
	out = coat(out, bevel, vec3(.70, .71, .65), p, aa)
	out = coat(out, max(d, abs(p.y-spine-.012)-.008), vec3(.49, .47, .40), p, aa)
	out = haft(out, p, -3.64, -2.90, .105, vec3(.23, .29, .07), aa)
	wrap := max(box(p-vec2(-3.26, 0), vec2(.34, .105)), abs(fract((p.x+p.y)*9)-.5)-.10)
	out = coat(out, wrap, vec3(.48, .47, .16), p, aa)
	out = coat(out, box(p-vec2(-2.88, .02), vec2(.05, .14)), gold, p, aa)
	out = ring(out, p, vec2(-3.72, .02), .135, .035, gold, aa)
	for k := 0; k < 4; k++ {
		f := float(k)
		out = ring(out, p, vec2(-3.70+f*.095, .17+.035*sin(f)), .045, .012, gold, aa)
	}
	return out
}
func swordBody(p vec2, id, t, aa float) vec4 {
	if id == 7.0 {
		return macheteBody(p, aa)
	}
	if id == 13.0 {
		return widowBody(p, aa)
	}
	if id == 14.0 || id == 15.0 {
		return dragonBladeBody(p, id, aa)
	}
	if id == 4.0 || id == 5.0 || id == 6.0 || id == 14.0 || id == 17.0 {
		p.y += .32
	}
	steel, gold, grip := vec3(.60, .71, .77), vec3(.76, .51, .19), vec3(.25, .11, .09)
	l, w := 3.4, .13
	if id == 1.0 {
		l = 3.6
		steel = vec3(.77, .86, .89)
		grip = vec3(.07, .15, .27)
	}
	if id == 2.0 {
		steel = vec3(.87, .62, .22)
	}
	if id == 3.0 {
		l = 2.65
		w = .19
	}
	if id == 4.0 || id == 6.0 {
		l = 3.9
		w = .09
	}
	if id == 5.0 {
		l = 2.75
		w = .085
	}
	if id >= 8.0 && id <= 14.0 {
		l = 1.7
		w = .11
	}
	if id == 10.0 || id == 11.0 {
		w = .23
		steel = vec3(.20, .25, .29)
	}
	if id == 13.0 {
		l = 2
		w = .04
	}
	if id == 15.0 {
		l = 3.4
		w = .23
		steel = vec3(.29, .07, .08)
	}
	if id == 16.0 {
		l = 2.6
		w = .17
		steel = vec3(.10, .20, .24)
	}
	if id == 17.0 {
		l = 3.2
		w = .14
		steel = vec3(.28, .70, .76)
	}
	u := clamp((p.x+l)/l, 0, 1)
	curve := 0.0
	if id == 4.0 || id == 5.0 || id == 6.0 || id == 12.0 || id == 14.0 || id == 17.0 {
		curve = .32 * u * u
	}
	q := p - vec2(0, curve)
	width := w * (1.0 - smoothstep(.76, 1, u))
	if id == 10.0 || id == 11.0 {
		width = w * (1 - u)
	}
	if id == 12.0 || id == 14.0 {
		width = w * (.8 + .8*sin(u*3.14)) * (1.0 - smoothstep(.7, 1.0, u))
	}
	serration := 0.0
	if id == 15.0 {
		serration = .08 * pow(.5+.5*sin(p.x*22), 4) * smoothstep(1, .5, u) * step(q.y, 0)
		steel = vec3(.39, .035, .055)
	}
	if id == 6.0 {
		steel = vec3(.39, .035, .055)
	}
	d := max(abs(q.y)-width-serration, max(-l-q.x, q.x))
	out := coat(vec4(0), d, metal(q, steel), q, aa)
	edge := max(d, abs(q.y+width*.78)-.012)
	out = coat(out, edge, mix(steel, vec3(.95, .97, 1), .5), q, aa*.7)
	if id == 6.0 || id == 15.0 {
		out = coat(out, max(d, abs(q.y-width*.6)-.013), vec3(.82, .12, .09), q, aa)
	}
	if id == 8.0 || id == 12.0 || id == 14.0 || id == 17.0 {
		vein := abs(q.y-.035*sin(p.x*11)) - .014
		out = coat(out, max(d+.035, vein), vec3(.11, .45, .23), q, aa)
	}
	if id == 16.0 {
		out = coat(out, max(d, abs(abs(q.y)-width*.85)-.016), vec3(.30, .94, 1), q, aa)
	}
	guard := .35
	if id == 4.0 || id == 5.0 || id == 6.0 {
		guard = .20
		grip = vec3(.055, .06, .075)
	}
	if id == 1.0 || id == 0.0 {
		gold = vec3(.43, .49, .51)
	}
	if id == 6.0 {
		gold = vec3(.31, .055, .07)
	}
	if id == 8.0 {
		gold = vec3(.46, .66, .51)
	}
	if id == 10.0 || id == 11.0 {
		guard = .17
		gold = vec3(.27, .29, .32)
	}
	if id == 3.0 || id == 9.0 || id == 2.0 {
		out = coat(out, curvedFitting(p, vec2(-l+.12, -guard), vec2(-l-.13, 0), vec2(-l+.12, guard), .048), gold, p, aa)
	} else if id != 16.0 {
		out = coat(out, capsule(p, vec2(-l+.05, -guard), vec2(-l+.05, guard), .044), gold, p, aa)
	}
	out = haft(out, p, -l-.80, -l-.09, .082, grip, aa)
	if id == 16.0 {
		out = coat(out, box(p-vec2(-l-.1, 0), vec2(.16, .18)), vec3(.17, .24, .26), p, aa)
		out = ring(out, p, vec2(-l-.1, 0), .092, .022, vec3(.12, .70, .83), aa)
	}
	if id == 4.0 || id == 5.0 || id == 6.0 {
		wrap := max(box(p-vec2(-l-.44, 0), vec2(.33, .08)), abs(fract((p.x+p.y)*8)-.5)-.12)
		out = coat(out, wrap, gold, p, aa)
	}
	if id == 10.0 || id == 11.0 {
		out = ring(out, p, vec2(-l-.96, 0), .15, .038, gold, aa)
	} else {
		out = coat(out, length(p-vec2(-l-.85, 0))-.105, gold, p, aa)
	}
	if id == 8.0 {
		out = coat(out, length(p-vec2(-l-.85, 0))-.055, vec3(.14, .71, .34), p, aa)
	}
	if id == 13.0 {
		center := vec2(-l-.4, 0)
		out = coat(out, length((p-center)*vec2(1, .8))-.12, gold, p, aa)
		for k := 0; k < 4; k++ {
			f := float(k)
			for j := 0; j < 2; j++ {
				s := float(j)*2 - 1
				out = coat(out, capsule(p, center+vec2((f-1.5)*.06, 0), center+vec2((f-1.5)*.14, s*.3), .018), gold, p, aa)
			}
		}
	}
	return out
}
func poleBody(p vec2, id, t, aa float) vec4 {
	if id == 30.0 {
		p.y += .29
	}
	steel, gold, wood := vec3(.54, .67, .72), vec3(.69, .48, .19), vec3(.29, .16, .085)
	if id == 22.0 || id == 27.0 || id == 28.0 || id == 29.0 {
		wood = vec3(.39, .08, .06)
	}
	if id == 25.0 {
		steel = vec3(.47, .64, .30)
	}
	if id == 26.0 {
		steel = vec3(.15, .18, .21)
	}
	if id == 29.0 {
		steel = vec3(.57, .58, .28)
	}
	if id == 31.0 {
		steel = vec3(.16, .12, .10)
	}
	if id == 24.0 {
		wood = vec3(.50, .45, .19)
	}
	if id == 31.0 {
		wood = vec3(.12, .12, .15)
	}
	out := haft(vec4(0), p, -5, -.9, .055, wood, aa)
	if id == 20.0 {
		gold = vec3(.50, .58, .63)
	}
	for k := 0; k < 2; k++ {
		out = coat(out, box(p-vec2(-4.75+float(k)*3.25, 0), vec2(.08, .071)), gold, p, aa)
	}
	out = coat(out, box(p-vec2(-1.3, 0), vec2(.22, .084)), metal(p, gold), p, aa)
	if id == 28.0 || id == 29.0 {
		if id == 29.0 {
			steel = vec3(.85, .73, .35)
		}
		for k := 0; k < 3; k++ {
			f := float(k) - 1.0
			if k != 1 {
				out = coat(out, curvedFitting(p, vec2(-1.4, 0), vec2(-.95, f*.6), vec2(-.58, f*.48), .051), gold, p, aa)
			} else {
				out = coat(out, capsule(p, vec2(-1.4, 0), vec2(-.45, 0), .042), gold, p, aa)
			}
			q := p - vec2(-abs(f)*.10, f*.48)
			width := .12 * max(0.0, 1.0-abs((q.x+.30)/.30))
			d := max(abs(q.y)-width, max(-.60-q.x, q.x))
			out = coat(out, d, metal(q, steel), p, aa)
			if id == 29.0 {
				out = coat(out, triangle(q, vec2(-.43, .035), vec2(-.53, .22), vec2(-.21, .04)), gold, p, aa)
			}
		}
		out = coat(out, length(p-vec2(-1.25, 0))-.12, gold, p, aa)
		if id == 29.0 {
			out = coat(out, length(p-vec2(-1.25, 0))-.067, vec3(.08, .52, .24), p, aa)
			for k := 0; k < 2; k++ {
				sg := float(k)*2 - 1
				out = coat(out, curvedFitting(p, vec2(-1.15, sg*.09), vec2(-1.01, sg*.48), vec2(-.70, sg*.35), .03), vec3(.11, .39, .15), p, aa)
			}
		} else {
			for k := 0; k < 3; k++ {
				f := float(k)
				out = coat(out, curvedFitting(p, vec2(-1.56, 0), vec2(-1.7-f*.12, .3), vec2(-1.42-f*.15, .55), .021), vec3(.65, .075, .045), p, aa)
			}
		}
	} else {
		len, width := 1.15, .15
		if id == 21.0 {
			len = 1.3
			width = .19
			steel = vec3(.31, .39, .40)
		}
		if id == 23.0 {
			len = 1.45
			width = .075
		}
		if id == 24.0 {
			len = 1.5
			width = .12
		}
		if id == 27.0 {
			len = 1.9
			width = .21
		}
		if id == 30.0 {
			len = 2.15
			width = .13
		}
		if id == 31.0 {
			len = 1.5
			width = .21
		}
		u := clamp((p.x+len)/len, 0, 1)
		q := p
		if id == 30.0 {
			q.y -= .29 * u * u
		}
		w := width * min(u/.32, (1-u)/.68)
		if id == 30.0 {
			w = width * sin(u*3.14159)
		}

		d := max(abs(q.y)-w, max(-len-p.x, p.x))
		out = coat(out, d, metal(q, steel), p, aa)
		if id == 26.0 {
			out = coat(out, max(d, abs(q.y-.05*sin(p.x*20))-.015), steel*1.9, p, aa)
		}
		if id == 31.0 {
			out = coat(out, max(d+.01, abs(q.y-.025*sin(p.x*13))-.023), vec3(1, .35, .04), p, aa)
		}
		if id == 25.0 || id == 27.0 {
			for k := 0; k < 3; k++ {
				f := float(k)
				for j := 0; j < 2; j++ {
					sg := float(j)*2 - 1
					root := vec2(-.6-f*.30, sg*(.13+f*.025))
					col := steel
					if id == 27.0 {
						col = gold
					}
					out = coat(out, triangle(p, root, root+vec2(-.25, sg*.19), root+vec2(-.13, -sg*.07)), col, p, aa)
				}
			}
		}
		if id == 27.0 {
			out = coat(out, max(d, abs(abs(q.y)-w*.85)-.018), gold, p, aa)
			out = coat(out, max(d+.03, abs(q.y)-.025), vec3(.60, .045, .04), p, aa)
		}
	}
	if id == 24.0 || id == 30.0 || id == 26.0 {
		tassel := vec3(.34, .12, .43)
		if id == 26.0 {
			tassel = vec3(.64, .49, .30)
		}
		if id == 24.0 {
			tassel = vec3(.22, .47, .12)
		}
		for k := 0; k < 4; k++ {
			f := float(k)
			out = coat(out, capsule(p, vec2(-1.6, .03), vec2(-1.85-f*.06, .30+f*.07), .018), tassel, p, aa)
		}
	}
	return out
}
func heavyBody(p vec2, id, t, aa float) vec4 {
	gold, steel, grip := vec3(.78, .52, .20), vec3(.40, .49, .54), vec3(.25, .12, .08)
	if id == 40.0 {
		grip = vec3(.08, .24, .40)
		steel = gold
	}
	if id == 44.0 || id == 45.0 || id == 48.0 || id == 49.0 {
		grip = vec3(.36, .055, .065)
	}
	out := haft(vec4(0), p, -3.0, -.65, .10, grip, aa)
	for k := 0; k < 2; k++ {
		out = coat(out, box(p-vec2(-2.95+float(k)*1.86, 0), vec2(.08, .14)), gold, p, aa)
	}
	q := p - vec2(-.5, 0)
	if id >= 46.0 {
		// Broad chamfered hammer blocks, metal straps and a distinct centre crest.
		body := vec3(.11, .43, .36)
		if id == 47.0 {
			body = vec3(.75, .48, .13)
		}
		if id == 48.0 {
			body = vec3(.47, .57, .61)
		}
		if id == 49.0 {
			body = vec3(.22, .035, .045)
		}
		halfWidth, halfHeight := .42, 1.02
		if id == 47.0 {
			halfWidth = .56
			halfHeight = .86
		}
		if id == 48.0 {
			halfWidth = .36
			halfHeight = .91
		}
		if id == 49.0 {
			halfWidth = .46
			halfHeight = 1.13
		}
		d := max(box(q, vec2(halfWidth, halfHeight)), abs(q.x)+abs(q.y)*.35-(halfWidth+.26))
		out = coat(out, d, body*(.60+.55*step(q.x, -.18)+.25*step(q.y, 0)), p, aa)
		if id == 46.0 {
			seam := min(abs(q.x+.13+q.y*.22), abs(q.x-.15-q.y*.11)) - .007
			out = coat(out, max(d+.055, seam), vec3(.33, .64, .49), p, aa)
		}
		if id == 49.0 {
			grid := fract(q*vec2(7, 9)) - .5
			scale := abs(grid.x) + abs(grid.y)*.6 - .30
			out = coat(out, max(d+.1, abs(scale)*.12-.012), gold*.65, p, aa)
		}
		for k := 0; k < 2; k++ {
			f := float(k)*2 - 1
			out = coat(out, max(d, abs(q.y-f*.70)-.073), gold, p, aa)
			out = coat(out, max(d, abs(q.y-f*.94)-.042), steel*1.4, p, aa)
		}
		out = coat(out, box(q, vec2(.45, .24)), gold, p, aa)
		crest := max(abs(q.x)*1.3+abs(q.y)-.27, -q.x-.3)
		out = coat(out, crest, body*1.6, p, aa)
		if id == 47.0 || id == 48.0 {
			// Carved mask/lion relief: brows, two sockets, muzzle and ridged mane.
			for k := 0; k < 2; k++ {
				f := float(k)*2 - 1
				out = coat(out, length(q-vec2(-.08, f*.10))-.047, vec3(.10, .08, .025), p, aa)
			}
			out = coat(out, length(q-vec2(.12, 0))-.083, gold*1.4, p, aa)
		}
		if id == 47.0 {
			cut := min(abs(abs(q.x)-.4), abs(abs(q.y)-.55)) - .025
			out = coat(out, max(d+.1, cut), vec3(.28, .17, .04), p, aa)
		}
		if id == 48.0 {
			mane := abs(length(q*vec2(1, .85))-.28) - .06
			out = coat(out, mane, gold*(.8+.3*sin(atan2(q.y, q.x)*12)), p, aa)
			out = coat(out, triangle(q, vec2(.1, -.1), vec2(.37, 0), vec2(.1, .1)), gold, p, aa)
		}
		if id == 49.0 {
			for k := 0; k < 3; k++ {
				f := float(k)
				for j := 0; j < 2; j++ {
					sg := float(j)*2 - 1
					out = coat(out, triangle(q, vec2(-.30+f*.18, sg*.9), vec2(-.32+f*.19, sg*1.26), vec2(-.15+f*.18, sg*.9)), gold, p, aa)
				}
			}
		}
	} else if id == 43.0 {
		d := max(box(p-vec2(-.95, 0), vec2(1.05, .21)), p.x+.05)
		out = coat(out, d, vec3(.16, .095, .07), p, aa)
		for k := 0; k < 9; k++ {
			f := float(k)
			for j := 0; j < 2; j++ {
				s := float(j)*2 - 1
				out = coat(out, length(p-vec2(-.2-f*.20, s*.17))-.052, steel, p, aa)
			}
		}
	} else {
		radius := .50
		if id == 40.0 {
			radius = .41
		}
		if id == 42.0 {
			steel = vec3(.76, .69, .49)
		}
		if id == 45.0 {
			steel = vec3(.11, .035, .02)
		}
		z := sqrt(max(0, 1-dot(q, q)/(radius*radius)))
		out = coat(out, length(q)-radius, steel*(.42+.6*z+.32*clamp(-q.y, 0, 1)), p, aa)
		for k := 0; k < 8; k++ {
			a := float(k)*.7854 + .15
			v := vec2(cos(a), sin(a))
			side := vec2(-v.y, v.x)
			along, across := dot(q, v), dot(q, side)
			tipRadius := .72
			if id == 40.0 || id == 42.0 {
				tipRadius = .81
			}
			spike := max(abs(across)-(tipRadius-along)*.30, max(.35-along, along-tipRadius))
			tip := steel
			if id == 40.0 || id == 44.0 || id == 45.0 {
				tip = gold
			}
			if id == 42.0 {
				tip = vec3(.79, .71, .51)
			}
			out = coat(out, spike, tip*(.7+.5*step(across, 0)), p, aa)
		}
		if id == 40.0 {
			out = coat(out, length(q)-.22, vec3(.45, .72, .84)*(1+z*.4), p, aa)
			out = ring(out, p, vec2(-.5, 0), .24, .024, gold, aa)
			out = coat(out, capsule(q, vec2(-.15, -.15), vec2(.15, .15), .025), gold, p, aa)
			out = coat(out, capsule(q, vec2(-.15, .15), vec2(.15, -.15), .025), gold, p, aa)
		}
		if id == 41.0 || id == 44.0 {
			studs := steel * 1.3
			if id == 44.0 {
				studs = gold
			}
			for k := 0; k < 4; k++ {
				a := float(k) * 1.5708
				v := vec2(cos(a), sin(a)) * .25
				out = coat(out, abs(q.x-v.x)+abs(q.y-v.y)-.085, studs, p, aa)
			}
		}
		if id == 42.0 {
			for k := 0; k < 2; k++ {
				f := float(k)*2 - 1
				out = coat(out, length((q-vec2(-.06, f*.19))*vec2(1.15, 1))-.105, vec3(.10, .075, .04), p, aa)
			}
			out = coat(out, box(q-vec2(.29, 0), vec2(.085, .23)), vec3(.73, .64, .43), p, aa)
			for k := 0; k < 4; k++ {
				out = coat(out, box(q-vec2(.30, -.17+float(k)*.11), vec2(.055, .012)), vec3(.19, .14, .065), p, aa)
			}
		}
		if id == 45.0 {
			vein := abs(sin(q.x*15+sin(q.y*17)) * sin(q.y*14+q.x*4))
			out = coat(out, max(length(q)-.46, vein*.07-.009), vec3(1, .15, .008), p, aa)
		}
	}
	return out
}
func polygon16(p vec2, points [16]vec2) float {
	d := 100.0
	inside := false
	for i := 0; i < 16; i++ {
		a, b := points[i], points[(i+1)%16]
		d = min(d, capsule(p, a, b, 0))
		if (a.y > p.y) != (b.y > p.y) {
			if p.x < (b.x-a.x)*(p.y-a.y)/(b.y-a.y)+a.x {
				inside = !inside
			}
		}
	}
	if inside {
		return -d
	}
	return d
}
func axeBody(p vec2, id, t, aa float) vec4 {
	steel, gold := vec3(.59, .66, .70), vec3(.78, .53, .20)
	if id == 61.0 {
		steel = gold
	}
	if id == 63.0 || id == 64.0 {
		steel = vec3(.84, .77, .57)
	}
	out := haft(vec4(0), p, -3.6, -.45, .088, vec3(.30, .12, .065), aa)
	for i := 0; i < 2; i++ {
		out = coat(out, box(p-vec2(-3.5+float(i)*2.8, 0), vec2(.08, .13)), gold, p, aa)
	}
	for k := 0; k < 2; k++ {
		if id == 60.0 && k == 1 {
			continue
		}
		sg := float(k)*2 - 1
		v := vec2(p.x, p.y*sg)
		if id == 63.0 && k == 1 {
			v = vec2(v.x+.06, v.y*1.28)
		}
		if id == 60.0 {
			v.y *= 1.2
		}
		outline := [16]vec2{vec2(-.63, .06), vec2(-.82, .18), vec2(-.91, .36), vec2(-.98, .56), vec2(-1.13, .78), vec2(-1.26, .91), vec2(-1.04, 1.10), vec2(-.76, 1.21), vec2(-.44, 1.22), vec2(-.14, 1.08), vec2(.08, .84), vec2(.19, .55), vec2(.20, .40), vec2(-.06, .38), vec2(-.33, .25), vec2(-.45, .10)}
		d := polygon16(v, outline)
		out = coat(out, d, steel*(.78+.30*step(v.x, -.70)), p, aa)
		rim := abs(d+.038) - .018
		out = coat(out, max(d, rim), steel*1.5, p, aa)
		if id == 61.0 {
			ornament := abs(sin(v.x*19+sin(v.y*11))) - .15
			out = coat(out, max(d+.09, ornament*.08), gold*.47, p, aa)
		}
		if id == 63.0 || id == 64.0 {
			out = coat(out, d+.11, vec3(.39, .04, .045), p, aa)
			grid := fract(v*vec2(8, 10)+vec2(v.y*2, 0)) - .5
			scale := abs(grid.x) + abs(grid.y)*.75 - .32
			out = coat(out, max(d+.13, abs(scale)*.09-.018), vec3(.12, .075, .035), p, aa)
			out = coat(out, curvedFitting(v, vec2(-.57, .03), vec2(-.33, .57), vec2(-.83, 1.23), .043), gold, p, aa)
			out = coat(out, triangle(v, vec2(-.89, .99), vec2(-1.22, 1.35), vec2(-1.12, .81)), steel, p, aa)
		}
	}
	out = coat(out, box(p-vec2(-.63, 0), vec2(.17, .21)), gold, p, aa)
	out = coat(out, length(p-vec2(-.63, 0))-.095, steel*.55, p, aa)
	return out
}
