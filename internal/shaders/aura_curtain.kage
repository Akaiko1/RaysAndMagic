//kage:unit pixels
package main

// A low procedural aurora along a tile edge. Inverse depth and U/depth
// anchor the moving light field to the world, independent of the camera.
// No source texture or offscreen blur pass is needed.

var Phase float

func Fragment(dstPos vec4, srcPos vec2, color vec4, custom vec4) vec4 {
	u := custom.y / custom.x
	v := (srcPos.x - (dstPos.y - imageDstOrigin().y)) / max(srcPos.y, 0.001)

	// Rays stream along the curtain; slower folds compress and curl them.
	// The upper part shears sideways without detaching the foot from the edge.
	fold := sin(u*4.2-Phase*2.0)*1.4 + sin(u*9.3+Phase*3.0)*0.55
	shear := v * (sin(u*3.6-Phase*3.0)*1.2 + sin(u*8.2+Phase*4.0)*0.45)
	rayPhase := u*custom.z*6.283185 - Phase*8.0 + fold + shear
	rays := 0.5 + 0.5*sin(rayPhase)
	rays = rays * rays * rays * rays

	// Local brightening travels at a different rate from the rays. Adjacent
	// folds reach their peaks separately instead of breathing as one fence.
	pulse := 0.5 + 0.5*sin(u*11.7+Phase*5.0+sin(u*4.6-Phase*3.0)*0.9)
	crest := 0.48 + 0.34*(0.5+0.5*sin(u*6.4-Phase*3.0+fold*0.35))
	// Fade unresolved rays to their mean intensity (35/128), avoiding shimmer.
	detail := 1.0 - smoothstep(0.12, 0.5, fwidth(rayPhase)/6.283185)
	rays = mix(0.2734375, rays, detail)
	veil := (0.10 + rays*(0.2+1.35*pulse*pulse)) * (1.0 - smoothstep(crest*0.15, crest, v))

	// A softer counterflow fills the gaps without locking every ray to the
	// same speed or height. All time terms are integer Phase multiples so the
	// renderer can wrap its clock without an animation jump.
	wispPhase := u*custom.z*3.9 + Phase*5.0 - fold*0.7 - shear
	wisps := 0.5 + 0.5*sin(wispPhase)
	wisps = wisps * wisps * wisps * wisps
	wispDetail := 1.0 - smoothstep(0.12, 0.5, fwidth(wispPhase)/6.283185)
	// Derivatives must execute across the whole quad before clipping.
	if v < 0.0 || v > 1.0 {
		return vec4(0)
	}
	wisps = mix(0.2734375, wisps, wispDetail)
	veil += wisps * (0.12 + 0.38*(1.0-pulse)) * (1.0 - smoothstep(0.12, 0.92-crest*0.3, v))
	// The stable foot keeps tactical tile boundaries legible during dim phases.
	foot := exp(-v*32.0)*0.7 + exp(-v*8.0)*0.18
	fade := max(0.0, 1.0-custom.w/custom.x)
	a := color.a * fade * (veil*0.65 + foot)
	tint := mix(color.rgb, vec3(1), 0.12*v+0.18*exp(-v*30.0))
	return vec4(tint, a)
}
