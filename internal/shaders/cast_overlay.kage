//kage:unit pixels
package main

var Phase float
var Style float
var Viewport vec2
var Origin vec2
var Pass float

//include veil_noise.kageinc
//include cast_styles.kageinc
//include preservation_flame.kageinc
//include advanced_life.kageinc
//include advanced_kinetic.kageinc
//include advanced_wards.kageinc
//include advanced_cast.kageinc

func Fragment(dst vec4, src vec2, color vec4) vec4 {
	p := (dst.xy - imageDstOrigin() - Origin - Viewport*vec2(.5, .46)) / Viewport.y
	t := Phase
	fade := smoothstep(0, .12, t) * (1 - smoothstep(.66, 1, t))
	if fade <= 0 {
		return vec4(0)
	}
	if Style != castStyleDarkness && Style != castStyleTownPortal { return advancedCast(p, t, fade, Style) }
	if Style == castStyleDarkness {
		// Advected folds gather from the edges; independent finer currents tear
		// the folds into smoke. The central sightline stays partly transparent.
		flow := p*vec2(.43, .26) + vec2(t*.065, -t*.16)
		warp := veilNoise(flow+vec2(.17, .39)) - .5
		n := veilNoise(flow + warp*.24)
		detail := veilNoise(p*.81 + warp*.18 + vec2(-t*.09, t*.11)).g
		fold := sin(p.x*20+warp.x*9+p.y*3-t*2.8)*.5 + .5
		edge := length(p * vec2(.85, 1))
		gather := smoothstep(.09, .70, edge+.18*n.r)
		density := clamp((n.g*.68+detail*.32)*1.2+fold*.12, 0, 1)
		a := fade * (.10 + gather*.82) * smoothstep(.15, .72, density)
		wisp := pow(max(0, 1-abs(density-.57)*10), 3) * gather
		rib := pow(fold, 9) * (.25 + .75*n.g)
		rgb := vec3(.018, .012, .037) + vec3(.16, .07, .27)*wisp + vec3(.07, .035, .13)*rib
		return vec4(rgb*a, a)
	}
	// The aperture is a deep surface, not an outlined badge. Polar advection
	// accelerates inward; the rim and the distant interior move independently.
	p.x *= 1.18
	r := length(p)
	a := atan2(p.y, p.x)
	opening := smoothstep(.015, .28, t)*(1-smoothstep(.82,1,t))
	radius := .015 + .34*opening
	if r > radius+.095 {
		return vec4(0)
	}
	direction := vec2(cos(a), sin(a))
	n := veilNoise(direction*.26+vec2(t*.07,-t*.04))
	warped := r+(n.r-.5)*.018*opening
	d := warped-radius
	rim := exp(-pow(d/.028,2))
	halo := exp(-abs(d)*39)*.35
	depth := clamp(r/max(.015,radius),0,1)
	angle := a+depth*4.5-t*2.2
	flowUV := vec2(cos(angle),sin(angle))*(.08+depth*.45)+vec2(t*.10,-t*.045)
	f := veilNoise(flowUV)
	inside := 1-smoothstep(-.008,.016,d)
	spiral := pow(max(0,.5+.5*sin(a*3+depth*12-t*8+f.r*4)),2)
	stream := spiral*smoothstep(.12,.85,depth)*(.45+.55*f.g)
	// Dark gaps between broad luminous folds make the throat recede.
	veil := inside*(.88-.15*depth)
	light := rim*(.55+.45*n.g)+halo
	rgb := inside*(vec3(.009,.014,.042)*veil+vec3(.08,.25,.55)*stream*.60)
	rgb += mix(vec3(.19,.45,.91),vec3(.65,.86,1),n.g)*light*.9
	// Sparse parallax points are embedded behind the inflowing surface.
	stars:=pow(max(0,f.r-.68)*3.125,10)*(1-smoothstep(.2,.9,depth))*inside
	rgb+=vec3(.53,.70,1)*stars*.55
	// Stable sector identities, never frame-random particles.
	sector := floor((a + 3.14159265) * 9)
	seed := fract(sin(sector*127.1+19.3) * 43758.5453)
	travel := fract(t*.8 + seed)
	sa := (sector+.25+seed*.5)/9 - 3.14159265 + t*.05
	sr := radius + .065*(1-travel)
	sparkDist := length(p - vec2(cos(sa), sin(sa))*sr)
	spark := exp(-sparkDist*420)*sin(travel*3.14159)*opening
	rgb += vec3(.63,.81,1)*spark
	alpha := clamp(veil+light*.80+spark,0,1)*fade
	return vec4(min(rgb*fade, vec3(alpha)), alpha)
}
