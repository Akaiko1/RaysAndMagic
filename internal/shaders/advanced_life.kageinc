// Cast-space material helpers keep all colours premultiplied before blending.
func spellLight(col vec3, energy, opacity, fade float) vec4 {
	a := clamp(opacity*fade,0,.88)
	c := mix(col,vec3(1),clamp(energy-.8,0,.65))
	return vec4(clamp(c,vec3(0),vec3(1))*a,a)
}

// A fern unrolls its terminal crozier; the established stem stays rooted.
func fernPoint(u, opening float) vec2 {
	base:=vec2(-.10+.13*u,.42-.76*u)
	tip:=smoothstep(.61,.99,u)
	a:=tip*5.8*(1-opening)
	return base+vec2(sin(a),1-cos(a))*.11*tip
}

func lifeCast(p vec2,t,fade,style float) vec4 {
	if abs(p.x)>.68 || abs(p.y)>.51 {return vec4(0)}
	ink:=vec3(.16,.9,.47)
	light,body:=float(0),float(0)
	if style==22 {
		// Blood climbs the blade against gravity. Drops spiral inward from
		// the sides, strike the edge, then become branching scarlet veins.
		if abs(p.x)>.25 {return vec4(0)}
		axis:=.024-.10*(p.y+.29)
		rgb:=vec3(0)
		a:=float(0)
		for i:=0;i<7;i++ {
			k:=float(i)
			u:=fract(t*.9+k*.137)
			side:=mix(-1,1,mod(k,2))
			pos:=vec2(axis+side*.20*(1-u)*(1-u),.32-u*.61)
			q:=p-pos
			d:=length(q/vec2(.006+.004*u,.013))
			drop:=1-smoothstep(.6,1.2,d)
			trail:=exp(-abs(q.x-side*q.y*.6)*370)*exp(-abs(q.y)*65)
			front:=step(.5,mod(k,2))
			if Pass<0 {front=1-front}
			rgb+=(vec3(.85,.015,.07)*drop+vec3(.59,.008,.045)*trail*.45)*front
			a+=(drop*.9+trail*.4)*front
		}
		if Pass>0 {
			warp:=veilNoise(vec2(p.x*4,p.y-t*.27)).r
			d:=abs(p.x-axis+sin(p.y*38+warp*3)*.008)
			vein:=exp(-d*450)*smoothstep(-.34,-.24,p.y)*(1-smoothstep(.20,.27,p.y))
			rgb+=vec3(1,.025,.09)*vein*.85
			a+=vein*.85
		}
		a=clamp(a,0,.95)*fade
		return vec4(min(rgb*fade,vec3(a)),a)
	} else if style==15 {
		opening:=smoothstep(.02,.70,t)
		stem:=float(10)
		for i:=0;i<28;i++ {
			u:=float(i)/28
			stem=min(stem,castSegment(p,fernPoint(u,opening),fernPoint(u+1.0/28,opening)))
		}
		body=(1-smoothstep(.005,.011,stem))*.85
		light=exp(-stem*115)*.22
		// Opposed tapered pinnae, with small lobes along each leaf edge. Broad
		// dark-green leaf tissue carries the form; veins remain subordinate.
		for i:=0;i<24;i++ {
			k:=floor(float(i)/2)
			u:=.12+k*.065
			side:=mix(-1,1,mod(float(i),2))
			anchor:=fernPoint(u,opening)
			open:=smoothstep(u*.55,u*.55+.26,t)
			q:=p-anchor
			q.x*=side
			lengthLeaf:=(.19*(1-u)+.025)*open+.001
			along:=q.x/lengthLeaf
			mid:=-.45*q.x-.10*q.x*q.x/lengthLeaf
			widthLeaf:=.032*sin(clamp(along,0,1)*3.14159)*(.78+.22*cos(along*34))
			leaf:=(1-smoothstep(widthLeaf,widthLeaf+.004,abs(q.y-mid)))*step(0,along)*(1-step(1,along))*open
			vein:=exp(-abs(q.y-mid)*620)*leaf
			body=max(body,leaf*(.63+.27*smoothstep(-.01,.01,q.y-mid)))
			light+=vein*.16
		}
		ink=mix(vec3(.018,.30,.12),vec3(.38,.91,.34),clamp(body*.6+light,0,1))
	} else {
		// Warm living material rises from the four party positions into one
		// shared reservoir, then returns outward. Broad streams have body,
		// travelling eddies and bright leading droplets, not connecting wires.
		for i:=0;i<4;i++ {
			k:=float(i)
			start:=vec2((k-1.5)*.25,.49)
			end:=vec2(.015,.04)
			v:=end-start
			len:=length(v);axis:=v/len
			u:=dot(p-start,axis)/len
			cross:=dot(p-start,vec2(-axis.y,axis.x))
			warp:=veilNoise(vec2(u*.74+k*.17,t*.24-k*.19))-.5
			curve:=cross-sin(u*3.14159)*(.05+.03*sin(k*2))-warp.x*.025
			width:=.021+.035*pow(max(0,sin(u*3.14159)),2)
			stream:=exp(-curve*curve/(width*width))
			valid:=smoothstep(-.06,.04,u)*(1-smoothstep(.9,1.05,u))
			progress:=smoothstep(.02,.46,t)
			if t>.5 {progress=1-smoothstep(.53,.97,t)}
			pulse:=exp(-pow((u-progress)*7,2))
			body+=stream*valid*(.22+.45*warp.y)*pulse
			light+=stream*valid*pulse*.8
		}
		pool:=exp(-length((p-vec2(.015,.04))*vec2(1,1.3))*30)*smoothstep(.15,.43,t)*(1-smoothstep(.6,.85,t))
		body+=pool*.7;light+=pool*.5
		ink=vec3(1,.60,.38)
	}
	// Slow drift, stable identities, and an envelope separate motes from noise.
	q:=p*vec2(45,26)+vec2(0,t*2)
	cell:=floor(q)
	seed:=fract(sin(dot(cell,vec2(127.1,311.7)))*43758.5453)
	mote:=exp(-length(fract(q)-vec2(seed,.5))*26)*step(.88,seed)
	mote*=smoothstep(.16,.32,abs(p.x))*(1-smoothstep(.38,.52,abs(p.y)))
	return spellLight(ink,light,body+light*.65+mote*.7,fade)
}

func cleansingCast(p vec2,t,fade,style float) vec4 {
	if abs(p.x)>.70 || abs(p.y)>.5 {return vec4(0)}
	if style==18 {
		// One warped enchanted curtain is stripped away by a clearing front.
		// Material tears into scraps and ash; it is not a bundle of fine lines.
		if abs(p.y)>.36 {return vec4(0)}
		front:=-.56+smoothstep(.10,.78,t)*1.20
		warp:=veilNoise(p*.9+vec2(t*.04,-t*.18))-.5
		n:=veilNoise(p*1.7+warp*.2+vec2(-t*.09,t*.12))
		fold:=.5+.5*sin(p.x*28+p.y*6+warp.x*9)
		span:=(1-smoothstep(.40,.60,abs(p.x)))*(1-smoothstep(.18,.34,abs(p.y+.04)))
		d:=p.x-front+warp.y*.12
		cloth:=smoothstep(-.04,.04,d)*span
		burn:=exp(-abs(d)*42)*span
		scraps:=smoothstep(.53,.73,n.g)*exp(-abs(d+.12)*14)*span
		light:=burn*.9+scraps*.5
		body:=cloth*(.22+fold*.32+n.g*.22)+scraps*.32
		return spellLight(mix(vec3(.26,.40,.71),vec3(.8,.94,1),burn),light,body+light*.60,fade)
	}
	// Purification opens translucent silk curtains. Fine filaments travel
	// through the folded material, which dissolves behind the clearing front.
	flow:=p*vec2(.65,.30)+vec2(t*.065,-t*.36)
	warp:=veilNoise(flow)-.5
	n:=veilNoise(flow+warp*.27)
	fold:=sin(p.x*33+p.y*5+warp.x*11-t*2.5)*.5+.5
	front:=-.5+t*1.15
	envelope:=exp(-pow((p.y-front)/.23,2))*(1-smoothstep(.38,.70,abs(p.x)))
	density:=pow(fold,4)*(.23+.77*n.g)*envelope
	filament:=pow(fold,18)*envelope
	light:=density*.7+filament*.8
	ink:=mix(vec3(.11,.48,.43),vec3(.66,1,.79),filament)
	return spellLight(ink,light,density*.48+filament*.42,fade)
}
