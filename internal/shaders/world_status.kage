//kage:unit pixels
package main

// Geometry carries local distances (or triangle barycentrics). Derivatives
// measure their final pixel footprint after either perspective or Panini.
func Fragment(dst vec4, src vec2, color vec4, custom vec4) vec4 {
	kind := floor(custom.w)
	d := length(src)-custom.x
	if kind == 1 {
		q := abs(src)-custom.xy
		d = length(max(q,vec2(0)))+min(max(q.x,q.y),0)
	} else if kind == 2 {
		d = abs(src.x)/custom.x+abs(src.y)/custom.y-1
	} else if kind == 3 {
		bary := vec3(src,1-src.x-src.y)
		width := max(abs(dfdx(bary))+abs(dfdy(bary)),vec3(0.00001))
		coverage := clamp(bary/width+vec3(0.5),vec3(0),vec3(1))
		return color*min(coverage.x,min(coverage.y,coverage.z))
	}
	width := max(abs(dfdx(d))+abs(dfdy(d)),0.00001)
	return color*clamp(0.5-d/width,0,1)
}
