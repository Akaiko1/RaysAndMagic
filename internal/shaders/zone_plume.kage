//kage:unit pixels
package main

//include veil_noise.kageinc

// Plume looks: the firePlume* constants in render_zone_plume.go;
// TestShaderConstantsMatchGo keeps the values equal.
const (
	firePlumeTongues = 0
	firePlumeBlaze = 1
)

// The plume's noise repeats every 8 units on the shared noise texels.
func fireNoise(p vec2) vec2 {
	return veilNoise(p/8.0 + vec2(.5)/imageSrc0Size())
}

// blaze is Firewall's fire, in the material of Preservation's light: a
// translucent body with a bright core. Tongues come from a rising noise field
// inside a wide soft envelope, so neighbouring columns merge into one fire with
// living gaps between tongues and no rounded or ruled bottom.
// p.x runs -1..1 across the column, p.y 0 (floor) to 1.
func blaze(p vec2, t, seed, alphaIn float) vec4 {
	y := p.y
	sway := fireNoise(vec2(p.x*1.1+seed, y*1.8-t*0.9)).x
	x := p.x + (sway-0.5)*(0.12+0.50*y)
	reach := 0.42 + 0.50*fireNoise(vec2(seed*0.7, t*0.35)).y
	rise := y / reach
	// Vertically stretched noise makes tongues; the threshold climbs with
	// height, so only strong tongues reach high and their tips sharpen.
	f1 := fireNoise(vec2(x*3.0+seed, y*1.6-t*2.4)).y
	f2 := fireNoise(vec2(x*6.0-seed, y*3.2-t*4.0)).x
	sides := 1.0 - smoothstep(0.55, 1.0, abs(x))
	density := (f1*0.70+f2*0.30)*sides + (1.0-rise)*0.55 - rise*0.35
	// The bed fades in unevenly, so the fire has no ruled bottom edge.
	ground := smoothstep(0.0, 0.05+0.07*f2, y)
	body := smoothstep(0.55, 0.78, density) * ground
	core := smoothstep(0.86, 1.10, density) * (1.0 - y) * ground
	haze := smoothstep(0.40, 0.62, density) * ground * 0.14
	col := mix(vec3(1.0, 0.40, 0.08), vec3(1.0, 0.76, 0.32), smoothstep(0.62, 0.95, density))
	col = mix(col, vec3(1.0, 0.96, 0.82), core)
	// Several columns overlap at every point, so each stays light; the stack
	// builds the blaze's density.
	a := clamp(body*0.62+core*0.30+haze, 0.0, 0.92) * alphaIn
	return vec4(col*a, a)
}

// Rising density is eroded throughout the flame, not only at its silhouette.
// Independent world seeds vary the curls and the height of overlapping plumes.
func Fragment(dst vec4, p vec2, color vec4, custom vec4) vec4 {
	// Ebitengine offsets source coordinates into image 0's atlas region.
	p -= imageSrc0Origin()
	t, seed, look := custom.x, custom.y, floor(custom.z+.5)
	if look == firePlumeBlaze {
		return blaze(p, t, seed, color.a)
	}
	flow := fireNoise(vec2(p.x*1.6+seed, p.y*2.5-t*0.85)).x
	curl := fireNoise(vec2(p.x*3.1-seed, p.y*3.9-t*1.35)).x
	x := p.x + (flow-0.5)*(0.16+p.y*0.65)
	q := vec2(x*3.7+seed, p.y*3.2-t*2.6)
	q.x += (curl - 0.5) * 1.2 * p.y
	noise := fireNoise(q).y
	envelope := pow(max(0.0, 1.0-p.y), 0.55) * (1.0 - smoothstep(0.42, 1.0, abs(x)))
	// Folded hot sheets leave moving dark openings between separate tongues.
	density := noise * envelope * 1.55
	flame := smoothstep(0.30, 0.70, density)
	heat := clamp((density-0.30)*1.8+(1.0-p.y)*0.15, 0.0, 1.0)
	tint := mix(vec3(0.63, 0.045, 0.002), vec3(1.0, 0.35, 0.016), smoothstep(0.0, 0.40, heat))
	tint = mix(tint, vec3(1.0, 0.86, 0.29), smoothstep(0.35, 0.75, heat))
	tint = mix(tint, vec3(1.0, 0.98, 0.81), smoothstep(0.78, 1.0, heat))
	// Wisps lose their light and opacity as they cool above the fire.
	smoke := smoothstep(0.40, 0.76, noise) * smoothstep(0.42, 0.78, p.y) * (1.0 - smoothstep(0.75, 1.0, p.y)) * envelope * 0.15
	alpha := (flame*0.90 + smoke) * smoothstep(0.0, 0.02, p.y) * color.a
	tint = mix(vec3(0.16, 0.10, 0.075), tint, flame/(flame+smoke+0.001))
	return vec4(tint*alpha, alpha)
}
