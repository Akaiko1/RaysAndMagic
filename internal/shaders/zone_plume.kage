//kage:unit pixels
package main

// Smooth periodic sampling of the shared, procedurally generated noise field.
func fireNoise(p vec2) vec2 {
	size := imageSrc0Size()
	q := fract(p/8.0) * size
	a := floor(q)
	f := fract(q)
	// Address texel centers; interpolate explicitly and wrap all four taps.
	origin := imageSrc0Origin() + vec2(0.5)
	v00 := imageSrc0At(origin + mod(a, size)).rg
	v10 := imageSrc0At(origin + mod(a+vec2(1, 0), size)).rg
	v01 := imageSrc0At(origin + mod(a+vec2(0, 1), size)).rg
	v11 := imageSrc0At(origin + mod(a+vec2(1, 1), size)).rg
	return mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y)
}

// Rising density is eroded throughout the flame, not only at its silhouette.
// Independent world seeds vary the curls and the height of overlapping plumes.
func Fragment(dst vec4, p vec2, color vec4, custom vec4) vec4 {
	// Ebitengine offsets source coordinates into image 0's atlas region.
	p -= imageSrc0Origin()
	t, seed := custom.x, custom.y
	flow := fireNoise(vec2(p.x*1.6+seed, p.y*2.5-t*0.85)).x
	curl := fireNoise(vec2(p.x*3.1-seed, p.y*3.9-t*1.35)).x
	x := p.x + (flow-0.5)*(0.16+p.y*0.65)
	q := vec2(x*3.7+seed, p.y*3.2-t*2.6)
	q.x += (curl - 0.5) * 1.2 * p.y
	noise := fireNoise(q).y
	envelope := pow(max(0.0, 1.0-p.y), 0.55) * (1.0 - smoothstep(0.42, 1.0, abs(x)))
	// Folded hot sheets leave moving dark openings between separate tongues.
	density := noise * envelope * 1.55
	flame := smoothstep(0.30, 0.70, density)
	heat := clamp((density-0.30)*1.8+(1.0-p.y)*0.15, 0.0, 1.0)
	tint := mix(vec3(0.63, 0.045, 0.002), vec3(1.0, 0.35, 0.016), smoothstep(0.0, 0.40, heat))
	tint = mix(tint, vec3(1.0, 0.86, 0.29), smoothstep(0.35, 0.75, heat))
	tint = mix(tint, vec3(1.0, 0.98, 0.81), smoothstep(0.78, 1.0, heat))
	// Wisps lose their light and opacity as they cool above the fire.
	smoke := smoothstep(0.40, 0.76, noise) * smoothstep(0.42, 0.78, p.y) * (1.0 - smoothstep(0.75, 1.0, p.y)) * envelope * 0.15
	alpha := (flame*0.90 + smoke) * smoothstep(0.0, 0.02, p.y) * color.a
	tint = mix(vec3(0.16, 0.10, 0.075), tint, flame/(flame+smoke+0.001))
	return vec4(tint*alpha, alpha)
}
