//kage:unit pixels
package main

var Time float
var DepthStage float

//include mesh_materials.kageinc
//include volume_vertex.kageinc

// Ranged depth-resolve stages by name (render_ranged_depth.go);
// TestShaderConstantsMatchGo keeps the values equal.
const (
	depthStageOff = 0
	depthStageHigh = 1
	depthStageLow = 2
	depthStageShade = 3
)

//include weapon_noise.kageinc

// Actual projected faces carry camera-space normals and a surface class. All
// inlay uses local surface coordinates; no item artwork is sampled.
// Rune coordinates run across the blade (X) and from tip to grip (Y).
func runeStroke(p, a, b vec2) float {
 v := b-a
 d := length(p-a-v*clamp(dot(p-a,v)/dot(v,v),0.0,1.0))
 return 1.0-smoothstep(.006,.011,d)
}
func stoneRune(p vec2) float {
 q := vec2(p.y,-p.x-1.20)
 r := runeStroke(q,vec2(0,-.17),vec2(0,.17))
 r = max(r,runeStroke(q,vec2(0,-.15),vec2(.045,-.06)))
 r = max(r,runeStroke(q,vec2(.045,-.06),vec2(0,.02)))
 r = max(r,runeStroke(q,vec2(0,.02),vec2(-.045,-.06)))
 q.y = -p.x-2.12
 r = max(r,runeStroke(q,vec2(-.045,-.16),vec2(0,-.07)))
 r = max(r,runeStroke(q,vec2(0,-.07),vec2(.045,-.16)))
 r = max(r,runeStroke(q,vec2(0,-.07),vec2(0,.16)))
 r = max(r,runeStroke(q,vec2(0,.03),vec2(.045,-.04)))
 q.y = -p.x-3.04
 r = max(r,runeStroke(q,vec2(-.045,-.16),vec2(-.045,.16)))
 r = max(r,runeStroke(q,vec2(-.045,-.16),vec2(.045,-.06)))
 r = max(r,runeStroke(q,vec2(.045,-.06),vec2(-.045,.04)))
 return max(r,runeStroke(q,vec2(-.045,.04),vec2(.045,.16)))
}
func Fragment(dst vec4, p vec2, color vec4, c vec4) vec4 {
 // Derivatives stay outside divergent depth clipping. Ordinary melee leaves
 // DepthStage zero and uses its original material path.
 pageAA := max(abs(dfdx(p.y))+abs(dfdy(p.y)),.001)
 if DepthStage != depthStageOff {
  depth := volumeDepth(c.w)
  high := floor(depth/256.0)
  low := depth-high*256.0
  if DepthStage == depthStageHigh { return vec4(high/255.0,high/255.0,high/255.0,1) }
  nearestHigh := floor(imageSrc0UnsafeAt(dst.xy+imageSrc0Origin()).r*255.0+.5)
  if abs(high-nearestHigh)>.25 { discard() }
  if DepthStage == depthStageLow { return vec4(low/255.0,low/255.0,low/255.0,1) }
  nearestLow := floor(imageSrc1UnsafeAt(dst.xy+imageSrc1Origin()).r*255.0+.5)
  if abs(low-nearestLow)>.25 { discard() }
 }
 n := normalize(c.xyz)
 light := max(0.0, dot(n, normalize(vec3(-.4,-.7,-.6))))
 spec := pow(max(0.0, dot(n, normalize(vec3(-.3,-.45,-1)))), 22.0)
 material := volumeMaterial(c.w)
 tint := color.rgb * (.38+.62*light)
 if material == meshMetal {
  tint += vec3(.28,.27,.24)*spec
 } else if material == meshStone {
  tint += color.rgb*.14 + vec3(.17,.22,.23)*spec
 } else if material == meshGlow {
  tint = color.rgb*(.85+.15*light)
 } else if material == meshRuneInlay {
  tint = mix(tint,vec3(.91,.70,.29),stoneRune(p))
 } else if material == meshBookPage {
  // Handwritten groups, an illuminated initial and an arcane diagram are ink
  // on the page. Derivatives were evaluated before this material branch.
  q := vec2(p.x,p.y)
  cell := vec2(fract((q.x-.14)/.065)*.065,fract((q.y+.48)/.075)*.075)
  glyph := floor((q.x-.14)/.065)
  stroke := abs(cell.y-.027-.009*sin(cell.x*130.0+glyph*2.0))
  ink := (1.0-smoothstep(.003,.003+pageAA,stroke))*(1.0-smoothstep(.045,.052,cell.x))
  ink *= smoothstep(.002,.006,cell.x)
  stem := (1.0-smoothstep(.002,.002+pageAA,abs(cell.x-.012)))*(1.0-smoothstep(.022,.028,abs(cell.y-.027)))
  ink = max(ink,stem)
  valid := step(.14,q.x)*step(q.x,.83)*step(-.48,q.y)*step(q.y,.48)
  // The central diagram interrupts the text, as on a real spellbook page.
  d := length((q-vec2(.48,.03))*vec2(1.0,1.1))
  diagram := 1.0-smoothstep(.003,.003+pageAA,abs(d-.145))
  diagram = max(diagram,1.0-smoothstep(.003,.003+pageAA,abs(d-.11)))
  if d < .16 { ink = diagram }
  tint = mix(tint,vec3(.19,.105,.065),ink*valid*.9)
 } else if material == meshHeldWater {
  // Two moving wave scales break up curved reflections. Analytic absorption
  // and warped caustics suggest a liquid volume without sampling the scene.
  a := p.x*8.0+p.y*6.0-Time*1.7
  b := p.x*13.0-p.y*10.0+Time*1.3
  wave := vec3(.11*cos(a)+.055*cos(b),.085*cos(a)-.07*cos(b),.035*sin(a+b))
  wn := normalize(n+wave)
  fresnel := .025+.975*pow(1.0-abs(wn.z),5.0)
  reflected := reflect(vec3(0,0,1),wn)
  sky := mix(vec3(.025,.09,.18),vec3(.55,.82,.90),smoothstep(-.35,.65,-reflected.y))
  thickness := 1.5*abs(wn.z)
  transmission := exp(-vec3(2.6,.70,.35)*thickness)
  q := p+wn.xy*.18+vec2(.045*sin(b),.06*sin(a))
  c1 := sin(q.x*8.0+1.7*sin(q.y*3.0-Time*.65)+Time*.9)
  c2 := sin(q.y*9.0+1.4*sin(q.x*4.0+Time*.55)-Time*.8)
  caustic := pow(clamp(1.0-abs(c1+c2)*.70,0.0,1.0),5.0)
  tint = vec3(.025,.43,.60)*(.55+.45*transmission)+vec3(.012,.075,.09)*caustic
  tint = mix(tint,sky,clamp(fresnel+.12,0.0,1.0))
  reflection := pow(max(0.0,dot(wn,normalize(vec3(-.38,-.55,-.9)))),52.0)
  broad := pow(max(0.0,dot(wn,normalize(vec3(-.44,-.60,-.8)))),9.0)
  tint += vec3(.62,.85,.92)*reflection+vec3(.12,.23,.26)*broad
 } else if material == meshHeldEmerald {
  rim := pow(1.0-abs(n.z),3.0)
  tint = color.rgb*(.55+.40*light)+vec3(.06,.24,.01)*rim
  tint += vec3(.7,1.0,.46)*pow(max(0.0,dot(n,normalize(vec3(-.35,-.4,-1)))),30.0)
 } else if material == meshHeldLava {
  // Fixed crust plates with slowly breathing molten seams. The ember stays
  // a solid in the basket; only the separate charged flame rises above it.
  q := p*17.0
  rock := fxNoise(q)
  seam := 1.0-smoothstep(.07,.22,abs(rock-.49))
  heat := .72+.28*sin(Time*2.1+fxNoise(q*.43)*6.0)
  crust := mix(vec3(.55,.045,.006),vec3(.88,.15,.012),rock)*(.85+.15*light)
  molten := mix(vec3(1.0,.25,.008),vec3(1.0,.78,.16),heat)
  tint = mix(crust,molten,seam)
 } else if material == meshHellfireMetal {
  // Molten channels live in the swept blade, with dark red forged banks.
  // Local coordinates keep the heat attached while the bow bends and turns.
  x := abs(p.x)
  center := .04+.20*smoothstep(.18,.85,x)-.17*smoothstep(1.0,1.5,x)-.29*smoothstep(1.5,1.82,x)
  channel := abs(p.y-center-.012*sin(x*19.0)-.007*sin(x*43.0))
  molten := 1.0-smoothstep(.009,.028,channel)
  edgeGlow := exp(-channel*44.0)*.20
  heat := .55+.45*fxNoise(vec2(x*7.0-Time*.65,p.y*9.0+Time*.12))
  iron := mix(vec3(.09,.012,.018),vec3(.32,.038,.032),light)
  iron += vec3(.24,.10,.08)*spec
  tint = mix(iron,mix(vec3(.85,.045,.003),vec3(1,.61,.075),heat),molten)
  tint += vec3(.42,.035,.002)*edgeGlow
 }
 return vec4(tint*color.a,color.a)
}
