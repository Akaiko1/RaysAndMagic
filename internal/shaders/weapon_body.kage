//kage:unit pixels
package main

// Actual projected faces carry camera-space normals and a surface class. All
// ornament is rigid geometry; shading never stretches a flat weapon picture.
func Fragment(dst vec4, p vec2, color vec4, c vec4) vec4 {
 n := normalize(c.xyz)
 light := max(0.0, dot(n, normalize(vec3(-.4,-.7,-.6))))
 spec := pow(max(0.0, dot(n, normalize(vec3(-.3,-.45,-1)))), 22.0)
 material := floor(c.w)
 tint := color.rgb * (.38+.62*light)
 if material == 0.0 {
  tint += vec3(.28,.27,.24)*spec
 } else if material == 2.0 {
  tint += color.rgb*.14 + vec3(.17,.22,.23)*spec
 } else if material == 3.0 {
  tint = color.rgb*(.85+.15*light)
 }
 return vec4(tint*color.a,color.a)
}
