//kage:unit pixels
package main

//include weapon_noise.kageinc

// UV is distance along the stroke / 36px and signed cross-stroke position.
// Custom: dissolve age (negative for a continuous filament), path fraction,
// stable seed, material + 0.25. Output is premultiplied for both blend modes.
func Fragment(dst vec4, uv vec2, color vec4, custom vec4) vec4 {
	age := max(0.0, custom.x)
	phase := age * 6.0
	if custom.x < 0.0 {
		phase = -custom.x - 1.0
	}
	material := floor(custom.w)
	flow := fxNoise(vec2(uv.x*1.8-phase, uv.y*2.5+custom.z))
	fine := fxNoise(vec2(uv.x*5.0+phase*0.6, uv.y*8.0+custom.z))
	bend := 0.025
	if material == 1.0 || material == 2.0 || material == 4.0 || material == 6.0 {
		bend = 0.22
	}
	cross := abs(uv.y + (flow-0.5)*bend)
	edge := 1.0 - smoothstep(0.78, 1.0, cross)
	body := exp(-cross * cross * 4.0)
	core := exp(-cross * cross * 95.0)
	rib := pow(0.5+0.5*sin(uv.y*18.0+flow*4.0-phase), 6.0) * body
	shade := 0.52 + 0.48*flow
	if material == 0.0 || material == 5.0 {
		// Metal/stone keep a straight bevel and a travelling specular edge.
		shade = 0.42 + 0.4*(1.0-cross) + 0.18*fine
		rib *= 0.25
	}
	if material == 3.0 {
		// Machinery has coherent luminous rails, without organic waviness.
		rib = pow(0.5+0.5*sin(uv.y*25.0), 10.0) * body * (0.6 + 0.4*flow)
	}
	death := min(0.985, 0.44+0.53*custom.y+(fine-0.5)*0.16)
	dissolve := 1.0 - smoothstep(death-0.15, death, age)
	burn := (1.0 - dissolve) * dissolve * 2.0
	a := min(1.0, color.a) * edge * (body*0.78 + core*0.22) * dissolve
	tint := color.rgb*shade + mix(color.rgb, vec3(1), 0.72)*(core*0.68+rib*0.3+burn*0.5)
 // Matter has a broad face with an offset bevel. A white axial filament
 // would turn a heavy hammer wake into a hair, regardless of mesh width.
 if material == 0.0 || material == 5.0 {
  a = min(1.0,color.a)*edge*(0.83+0.17*flow)*dissolve
  bevel := exp(-(uv.y+0.45)*(uv.y+0.45)*22.0)
  tint = color.rgb*(0.48+0.5*flow+0.3*(1.0-cross))
  tint += mix(color.rgb,vec3(1),0.5)*bevel*0.28
 }
 if material == 6.0 {
  a=min(1.0,color.a)*edge*(0.48+0.52*flow)*dissolve
  tint=color.rgb*(0.58+0.55*flow)+vec3(0.12)*fine
 }
	return vec4(tint*a, a)
}
