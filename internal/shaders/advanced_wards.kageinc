// flameWisp is a torn-off flame tongue: a small teardrop, round at its base
// and drawn to a point at the top, that sways, shrinks and fades as it rises.
// q is the offset from the wisp's base in equally scaled units with y UP;
// size is its height and life runs 0..1. Returns its opacity.
func flameWisp(q vec2, size, life float) float {
	h := size * (1.0 - 0.55*life)
	w := h * 0.30
	u := q.y / h
	x := q.x - sin(u*4.0+life*9.0)*w*0.7*max(u, 0.0)
	r := w * pow(max(0.0, 1.0-u), 1.3)
	if u < 0.0 {
		r = w * sqrt(max(0.0, 1.0-(u/0.30)*(u/0.30)))
	}
	body := 1.0 - smoothstep(r*0.35, r+0.0001, abs(x))
	return body * step(u, 1.0) * pow(1.0-life, 1.2) * smoothstep(0.0, 0.12, life)
}

// preservationFlame is the ghost light the wings embrace, in the place and at
// the size of the old candle (screen .51-.75 of the viewport height): a heavy
// round body, a thin tip that burns actively, and sparks that tear off it.
func preservationFlame(p vec2,t,fade float) vec4 {
	if abs(p.x)>.13 || p.y < -.16 || p.y > .32 {return vec4(0)}
	grow:=.45+.55*smoothstep(.02,.28,t)
	R:=.066*grow
	baseY:=.218
	H:=(.20+.022*sin(t*23)+.014*sin(t*41+1.3))*grow
	dy:=p.y-baseY
	h:=-dy/H
	n:=veilNoise(vec2(p.x*4.5,p.y*2.4-t*2.6))
	// The tip sways and licks; the heavy base barely moves.
	hh:=max(h,0)
	x:=p.x-(n.r-.5)*.08*hh*hh-.014*sin(t*16+hh*6)*hh
	r:=float(0)
	if dy>0 {
		r=sqrt(max(0,R*R-dy*dy))
	} else {
		r=R*pow(max(0,1-h),1.3)*(1+.30*(n.g-.5)*h)
	}
	d:=abs(x)/max(r,.0004)
	body:=(1-smoothstep(.62,1.04,d))*step(h,1.05)
	// Tongues of light flow up through the translucent body.
	tongue:=veilNoise(vec2(x*6.5,p.y*3.6-t*4.2)).g
	core:=exp(-length(vec2(x/(R*.55),(dy+R*.25)/(R*.9)))*1.6)*(1-smoothstep(.55,1,h))
	halo:=exp(-max(0,abs(x)-r)*38)*smoothstep(1.25,.2,h)*(1-smoothstep(0,.06,dy-R))
	col:=mix(vec3(1,.52,.12),vec3(1,.82,.36),smoothstep(.25,.75,tongue))
	col=mix(col,vec3(1,.97,.84),core)
	a:=body*(.58+.26*tongue+.40*core)+halo*.38
	rgb:=col*a
	// Torn-off tongues leave the tip, rise, drift and burn out (y flips to up).
	for i:=0;i<6;i++ {
		k:=float(i)
		life:=fract(t*2.4+k*.381)
		seed:=fract(sin(k*91.7)*437.5)
		tip:=vec2(0,baseY-H*.80)
		pos:=tip+vec2((seed-.5)*.028+sin(life*7+k)*.012*life,-life*(.10+.05*seed))
		q:=p-pos
		wisp:=flameWisp(vec2(q.x,-q.y),.032,life)*.85
		rgb+=vec3(1,.74,.30)*wisp*(1-a)
		a=max(a,wisp)
	}
	a=clamp(a*fade,0,.95)
	return vec4(min(rgb*fade,vec3(a)),a)
}

func advancedWard(p vec2,t,fade,style float) vec4 {
	if style==9 {return preservationFlame(p,t,fade)}
	if style==21 {return celestialSparks(p,t,fade)}
	if abs(p.x)>.62 || abs(p.y)>.48 {return vec4(0)}
	rgb:=vec3(0)
	alpha:=float(0)
	if style==4 || style==17 {
		// A slanted curved barrier grows from the contact region. Broad
		// interference patches carry its volume; there is no closed neon rim.
		// Shield and Protection from Magic share geometry and motion.
		base:=vec3(.025,.25,.10)
		patchColor:=vec3(.22,.53,.12)
		reflectionColor:=vec3(.50,.77,.36)
		lipColor:=vec3(.42,1,.32)
		poolColor:=vec3(.56,1,.25)
		waveColor:=vec3(.78,1,.58)
		if style==4 {
			base=vec3(.025,.10,.25)
			patchColor=vec3(.12,.30,.53)
			reflectionColor=vec3(.36,.57,.77)
			lipColor=vec3(.32,.65,1)
			poolColor=vec3(.25,.65,1)
			waveColor=vec3(.58,.82,1)
		}
		q:=vec2(p.x+p.y*.22+.025,p.y-.015)/vec2(.47,.39)
		r:=length(q)
		shape:=max(r*.92,max(abs(q.x)*.90+abs(q.y)*.30,abs(q.y)*.93+q.x*.13))
		expand:=.15+.85*smoothstep(.03,.26,t)
		inside:=1-smoothstep(expand-.045,expand+.015,shape)
		z:=sqrt(max(.01,1-dot(q*.68,q*.68)))
		normal:=normalize(vec3(q.x*.65,q.y*.65,z))
		uv:=q*.24+normal.xy*.16
		warp:=veilNoise(uv+vec2(t*.045,-t*.03))-.5
		n:=veilNoise(uv+warp*.10+vec2(-t*.04,t*.06))
		patch:=smoothstep(.25,.70,n.r+normal.y*.16)
		reflection:=pow(max(0,dot(normal,normalize(vec3(-.65,-.35,1)))),9)
		fresnel:=pow(1-z,2)
		lip:=exp(-abs(shape-expand)*70)*smoothstep(.1,.8,patch)*.3
		film:=(.10+.18*patch+.20*reflection+fresnel*.35)*inside
		rgb=(base+patchColor*patch+reflectionColor*reflection)*film
		rgb+=lipColor*lip
		alpha=film+lip*.5
		for i:=0;i<3;i++ {
			k:=float(i)
			u:=t-(.24+k*.18)
			center:=vec2(-.21+k*.20,-.12+.11*sin(k*2.3))
			d:=length((p-center)*vec2(1,1.25))
			pulse:=smoothstep(-.025,.016,u)*exp(-max(0,u)*8)
			radius:=.045+max(0,u)*.65
			pool:=exp(-d*d/(radius*radius))*pulse*inside
			wave:=exp(-pow((d-radius)*32,2))*pulse*inside
			cells:=smoothstep(.46,.73,n.g+warp.r*.18)
			rgb+=poolColor*pool*(.60+.35*cells)+waveColor*wave*.24
			alpha+=pool*.64+wave*.20
		}
	} else {
		// An asymmetric cracked mirror. A scarlet wound strikes its surface;
		// cracks carry the pulse back toward the attacker.
		q:=p-vec2(-.02,-.015)
		q=vec2(q.x+.20*q.y,q.y)
		d:=length(q/vec2(.28,.36))
		glass:=1-smoothstep(.98,1.01,d)
		rim:=exp(-abs(d-1)*100)
		n:=veilNoise(q*.9+vec2(t*.07,0))
		reflection:=pow(max(0,sin(q.x*14+q.y*6+n.r*4-t*4)),8)*glass
		rgb=vec3(.046,.025,.071)*glass*.8+vec3(.62,.68,.78)*(reflection*.30+rim*.70)
		alpha=glass*.62+reflection*.13+rim*.65
		for i:=0;i<6;i++ {
			k:=float(i);angle:=k*1.0472+.19*sin(k*3)
			v:=vec2(cos(angle),sin(angle))
			u:=dot(q-vec2(.07,-.03),v)
			cross:=dot(q-vec2(.07,-.03),vec2(-v.y,v.x))
			crack:=exp(-abs(cross+.008*sin(u*63+k))*550)*step(0,u)*glass
			pulse:=exp(-pow((u-fract(t*1.7)*.42)*20,2))
			rgb+=mix(vec3(.39,.32,.46),vec3(1,.035,.12),pulse)*crack*.85
			alpha+=crack*.45
		}
	}
	alpha=clamp(alpha,0,.92)*fade
	return vec4(min(rgb*fade,vec3(alpha)),alpha)
}

// celestialSparks is the icon's gold orbit behind the cuirass with three
// four-point stars riding it. The cuirass anchor sits at .43 of the viewport
// height with a .25-height model scale, so its centre is p.y = -.03.
func celestialSparks(p vec2,t,fade float) vec4 {
	c:=vec2(0,-.105)
	radii:=vec2(.235,.19)
	q:=p-c
	tilt:=.10
	q=vec2(q.x*cos(tilt)+q.y*sin(tilt),-q.x*sin(tilt)+q.y*cos(tilt))
	if abs(q.x)>.29 || abs(q.y)>.25 {return vec4(0)}
	e:=length(q/radii)
	d:=(e-1)*min(radii.x,radii.y)
	// The orbit is drawn around from the top as the cast opens.
	theta:=atan2(q.y/radii.y,q.x/radii.x)
	sweep:=fract((theta+1.5708)/6.28319)
	drawn:=1-smoothstep(-.02,.02,sweep-smoothstep(.04,.34,t))
	ring:=exp(-pow(d/.0028,2))*drawn
	rgb:=vec3(.86,.67,.31)*ring*.85
	a:=ring*.78
	star:=float(0)
	for i:=0;i<3;i++ {
		k:=float(i)
		at:=-1.5708+k*2.0944+.35*t
		pos:=vec2(cos(at)*radii.x,sin(at)*radii.y)
		s:=q-pos
		twinkle:=.75+.25*sin(t*18+k*2.1)
		size:=1.0
		if i==0 {size=1.45} // the crown star above the gorget leads
		arms:=max(exp(-abs(s.x)*420/size)*exp(-abs(s.y)*48/size),exp(-abs(s.y)*420/size)*exp(-abs(s.x)*48/size))
		core:=exp(-length(s)*150/size)
		star+=(arms+core)*twinkle*smoothstep(.08+k*.06,.20+k*.06,t)
	}
	star=min(star,1)
	rgb+=vec3(.86,.93,1)*star
	a=max(a,star)
	a*=fade
	return vec4(min(rgb*fade,vec3(a)),a)
}
