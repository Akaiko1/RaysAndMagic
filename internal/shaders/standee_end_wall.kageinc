// standeeEndWallGrain is the core's horizontal grain (prepareStandeePixels in
// render_standee.go) at a level-0 row, measured from the art's top edge. It
// fades where rows shrink below the grain's period, as the core's mips do;
// rowsPerPixel is the caller's, taken before its surface branches.
func standeeEndWallGrain(row float, rowsPerPixel float) float {
	phase := (row - 0.5) * 0.9
	detail := 1.0 - smoothstep(0.12, 0.5, rowsPerPixel*0.9/6.283185)
	return 1.0 + 0.08*detail*sin(phase)
}
