//kage:unit pixels

package main

// Surfaces by name: the standeeLayer* constants in render_standee.go;
// TestShaderConstantsMatchGo keeps the values equal.
const (
	standeeLayerNearSticker = 0
	standeeLayerCore = 1
	standeeLayerFarSticker = 2
)

var Horizon float

// The sheet variant of standee_trilinear.kage for reduced levels. One image
// holds a token's sticker and core levels (standeeSheet in
// render_standee_sheet.go) and the shader reads no per-image region, so tokens
// whose sheets share an atlas merge into one draw.
//
//	srcPos     level block origin on the sheet; fractions carry the surface
//	           (x) and the mip blend (y)
//	custom.x   projected height at this column (height invariant over depth)
//	custom.y   source U times that height
//	custom.z   bottom below the horizon, in projected heights
//	custom.w   major-axis footprint, negative for vertical minification
//	color      premultiplied tint
//
// A block is a header row (full size, level size) above the level's sticker
// and, to its right, its core; the next level's block follows below.
func sheetSize(c vec4) vec2 {
	b := floor(c.rgb*255.0 + 0.5)
	hi := floor(b.g / 16.0)
	return vec2(b.r*16.0+hi, (b.g-hi*16.0)*256.0+b.b)
}

// sheetLinear samples one level; p is in full-size pixels of the token art.
// It fetches at texel centres, as standee_sampling.kageinc explains.
func sheetLinear(p vec2, origin vec2, size vec2, size0 vec2) vec4 {
	q := clamp(p*(size/size0), vec2(0.5), size-vec2(0.5))
	base := floor(q - 0.5)
	rate := q - 0.5 - base
	p0 := base + 0.5 + origin
	p1 := p0 + 1.0
	c0 := imageSrc0UnsafeAt(p0)
	c1 := imageSrc0UnsafeAt(vec2(p1.x, p0.y))
	c2 := imageSrc0UnsafeAt(vec2(p0.x, p1.y))
	c3 := imageSrc0UnsafeAt(p1)
	return mix(mix(c0, c1, rate.x), mix(c2, c3, rate.x), rate.y)
}

func sheetSticker(p vec2, origin vec2, size vec2, next vec2, size0 vec2, mipBlend float) vec4 {
	lo := sheetLinear(p, origin, size, size0)
	if mipBlend <= 0.0 {
		return lo
	}
	return mix(lo, sheetLinear(p, origin+vec2(0, size.y+1.0), next, size0), mipBlend)
}

func sheetNearSticker(p vec2, origin vec2, size vec2, next vec2, size0 vec2, mipBlend float, footprint vec2) vec4 {
	// Four taps extend the isotropic mip along only the compressed axis.
	texel := mix(size0/size, size0/next, mipBlend)
	span := max(footprint-1.5*texel, vec2(0))
	if span.x <= 0.0 && span.y <= 0.0 {
		return sheetSticker(p, origin, size, next, size0, mipBlend)
	}
	return (sheetSticker(p-span*0.375, origin, size, next, size0, mipBlend) + sheetSticker(p-span*0.125, origin, size, next, size0, mipBlend) +
		sheetSticker(p+span*0.125, origin, size, next, size0, mipBlend) + sheetSticker(p+span*0.375, origin, size, next, size0, mipBlend)) * 0.25
}

func Fragment(rawDstPos vec4, srcPos vec2, color vec4, custom vec4) vec4 {
	dstPos := vec4(paniniSourcePoint(rawDstPos.xy-imageDstOrigin())+imageDstOrigin(),rawDstPos.zw)
	block := floor(srcPos)
	code := srcPos - block
	size0 := sheetSize(imageSrc0UnsafeAt(block + vec2(0.5)))
	size := sheetSize(imageSrc0UnsafeAt(block + vec2(1.5, 0.5)))
	next := max(floor(size*0.5), vec2(1))
	sticker := block + vec2(0, 1)
	surface := floor((code.x-0.25)*8.0 + 0.5) // an exact id, safe from interpolation error
	mipBlend := clamp((code.y-0.125)/0.75, 0.0, 1.0)

	// Reconstruct perspective at the pixel centre from the affine height.
	height := custom.x
	u := clamp(custom.y/height, 0.0, 1.0)
	top := Horizon + (custom.z-1.0)*height
	v := (dstPos.y - imageDstOrigin().y - top) / height
	p := vec2(min(u*size0.x, size0.x-1.0)+0.5, v*(size0.y-1.0)+0.5)

	if surface == standeeLayerFarSticker {
		return sheetSticker(p, sticker, size, next, size0, mipBlend) * color
	}
	if surface == standeeLayerCore {
		return sheetLinear(p, sticker+vec2(size.x, 0), size, size0) * color
	}
	footprint := vec2(max(custom.w, 0.0), max(-custom.w, 0.0))
	return sheetNearSticker(p, sticker, size, next, size0, mipBlend, footprint) * color
}

//include panini.kageinc
