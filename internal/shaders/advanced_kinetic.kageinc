func castSegment(p,a,b vec2) float {
	v,w:=p-a,b-a
	return length(v-w*clamp(dot(v,w)/max(dot(w,w),.000001),0,1))
}

func kineticCast(p vec2,t,fade,style float) vec4 {
	light,body:=float(0),float(0)
	ink:=vec3(.85,.57,.19)
	if style==castStyleHaste {
		// Haste bends time into broad swept ribbons with sharp leading glints.
		for i:=0;i<6;i++ {
			k:=float(i)
			side:=mix(-1,1,mod(k,2))
			q:=vec2(p.x*side,p.y)
			curve:=.21+pow(abs(q.y+.03),1.5)*1.5+k*.017
			d:=abs(q.x-curve)
			travel:=fract(t*(.75+k*.1)+k*.173)
			head:=.45-travel*.95
			tail:=smoothstep(head-.02,head+.07,q.y)*(1-smoothstep(head+.12,head+.43,q.y))
			light+=exp(-d*470)*tail*.55
			body+=exp(-d*85)*tail*.12
			light+=exp(-length(vec2((q.x-curve)*.7,q.y-head))*230)
		}
	} else if style==castStyleFate {
		// Fate is an asymmetric constellation, with a cloudy golden wake.
		// Adjacent stars awaken in sequence rather than drawing a geometric seal.
		for i:=0;i<5;i++ {
			k:=float(i)
			pos:=vec2((k-2)*.145,-.06+.12*cos(k*2.5))
			q:=p-pos
			star:=exp(-abs(q.x)*320-abs(q.y)*55)+exp(-abs(q.x)*55-abs(q.y)*320)
			lit:=smoothstep(k*.045,k*.045+.18,t)
			light+=star*lit*(.75+.25*pow(max(0,sin(t*6+k)),2))
			light+=exp(-length(q)*32)*.13*lit
			if i<4 {
				to:=vec2((k-1)*.145,-.06+.12*cos((k+1)*2.5))
				line:=castSegment(p,pos,to)
				light+=exp(-line*640)*.3*lit
				body+=exp(-line*70)*.09*lit
			}
		}
		r:=length(p)
		n:=veilNoise(p*.72+vec2(t*.08,-t*.07))
		veil:=pow(max(0,sin(p.y*40+p.x*12+n.r*7-t*2)),6)
		body+=veil*exp(-r*5)*.23
		ink=vec3(1,.70,.24)
	}
	return spellLight(ink,light,light*.7+body,fade)
}
