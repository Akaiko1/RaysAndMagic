func clockGear(out vec4, p, center vec2, r, aa float) vec4 {
	q := p - center
	a := atan2(q.y, q.x)
	teeth := r * (.88 + .12*step(.22, cos(a*12)))
	gold := vec3(.83, .57, .23)
	out = coat(out, length(q)-teeth, gold, p, aa)
	out = coat(out, length(q)-r*.69, vec3(.19, .14, .085), p, aa)
	out = ring(out, p, center, r*.57, r*.075, gold, aa)
	out = coat(out, length(q)-r*.24, gold, p, aa)
	return out
}
func clockBody(p vec2, id, t, aa float) vec4 {
	gold, steel := vec3(.82, .57, .23), vec3(.41, .70, .90)
	out := vec4(0)
	if id == 70.0 || id == 74.0 {
		bladeLength, width := 3.4, .13
		if id == 74.0 {
			bladeLength = 3.7
			width = .034
			steel = vec3(.79, .77, .68)
		}
		u := clamp((p.x+bladeLength)/bladeLength, 0, 1)
		d := max(abs(p.y)-width*(1.0-smoothstep(.75, 1, u)), max(-bladeLength-p.x, p.x))
		out = coat(out, d, metal(p, steel), p, aa)
		out = coat(out, max(d, abs(p.y+width*.68)-.014), vec3(.8, .94, 1), p, aa)
		out = haft(out, p, -bladeLength-.79, -bladeLength-.06, .072, gold, aa)
		if id == 70.0 {
			out = clockGear(out, p, vec2(-bladeLength+.05, 0), .37, aa)
		} else {
			for k := 0; k < 2; k++ {
				sg := float(k)*2 - 1
				out = coat(out, curvedFitting(p, vec2(-bladeLength+.06, 0), vec2(-bladeLength-.58, sg*.72), vec2(-bladeLength-.53, sg*.10), .026), gold, p, aa)
				out = coat(out, curvedFitting(p, vec2(-bladeLength, 0), vec2(-bladeLength+.25, sg*.31), vec2(-bladeLength-.24, sg*.27), .023), gold, p, aa)
			}
		}
		out = coat(out, length(p-vec2(-bladeLength-.87, 0))-.10, gold, p, aa)
	} else if id == 73.0 {
		out = haft(out, p, -4.9, -1.05, .047, vec3(.26, .22, .17), aa)
		for k := 0; k < 9; k++ {
			f := float(k)
			out = coat(out, box(p-vec2(-1.35-f*.38, 0), vec2(.032, .078)), gold, p, aa)
		}
		width := .18 * min(clamp((p.x+1.2)/.45, 0, 1), clamp(-p.x/.75, 0, 1))
		d := max(abs(p.y)-width, max(-1.2-p.x, p.x))
		out = coat(out, d, metal(p, steel), p, aa)
		out = coat(out, max(d, abs(abs(p.y)-width*.8)-.012), vec3(.8, .94, 1), p, aa)
		for k := 0; k < 2; k++ {
			sg := float(k)*2 - 1
			out = coat(out, triangle(p, vec2(-1.2, 0), vec2(-.86, sg*.35), vec2(-1.45, sg*.15)), gold, p, aa)
		}
	} else {
		out = haft(out, p, -3.1, -.50, .087, vec3(.27, .15, .07), aa)
		for k := 0; k < 3; k++ {
			out = coat(out, box(p-vec2(-3.0+float(k)*.84, 0), vec2(.055, .12)), gold, p, aa)
		}
		center := vec2(-.45, 0)
		if id == 72.0 {
			out = clockGear(out, p, center, .66, aa)
		} else {
			out = coat(out, box(p-center, vec2(.37, .66))-.06, gold*.75, p, aa)
			for k := 0; k < 2; k++ {
				sg := float(k)*2 - 1
				out = coat(out, triangle(p, center+vec2(-.30, sg*.52), center+vec2(0, sg*1.0), center+vec2(.30, sg*.52)), gold, p, aa)
			}
			out = coat(out, length(p-center)-.53, gold*1.1, p, aa)
			out = coat(out, length(p-center)-.44, vec3(.88, .81, .60), p, aa)
			q := p - center
			a := atan2(q.y, q.x)
			rad := length(q)
			ticks := max(abs(rad-.365)-.029, abs(sin(a*6))*.08-.013)
			out = coat(out, ticks, vec3(.20, .13, .06), p, aa)
			out = coat(out, capsule(p, center, center+vec2(-.06, -.29), .014), vec3(.13, .10, .06), p, aa)
			out = coat(out, capsule(p, center, center+vec2(.20, .11), .018), vec3(.13, .10, .06), p, aa)
			for k := 0; k < 4; k++ {
				f := float(k)
				out = ring(out, p, vec2(-1.1, .16+f*.11), .04, .014, gold, aa)
			}
			out = ring(out, p, vec2(-1.1, .78), .14, .035, gold, aa)
		}
	}
	return out
}
