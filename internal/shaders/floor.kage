//kage:unit pixels

package main

// floorShaderSrc is a Kage fragment shader that renders the perspective
// floor. Per-fragment logic:
//
//	rowDist  = RowDistFactor / (px.y - Horizon)
//	s        = 2-px.x / ScreenSize.x - 1
//	floorX   = camX + rowDist-DirCos + rowDist-PlaneCos-s
//	floorY   = camY + rowDist-DirSin + rowDist-PlaneSin-s
//	tx, ty   = floor(floor[XY] / TileSize)
//	base     = floorColorMap[tx, ty]
//	material = floorTextureIndexMap[tx, ty] (base, shore, profile/flags)
//	mip      = clamp(log2(max(texelsX, texelsY)), 0, MaxMip)
//	texel    = filtered material/shore blend # manual mips - Kage has none
//	color    = mix(base, texel, 0.8) - brightness(dist, lights)
//
// Inputs:
//
//	Images[0] = floorColorMap (worldWxworldH RGBA8 base colors)
//	Images[1] = floorTexAtlas (horizontal strip of N floor textures, mip
//	            chain strips stacked below - see buildFloorTexAtlas)
//	Images[2] = floorTextureIndexMap (R = base index + 1, G = shore index + 1, B = profile/flags)
//	Images[3] = floorShoreMap (vertex distances / 2: R to water, G to the bank)

// Index-map B by name: the floorBlend* profiles, the profile modulus and the
// flag bits in render_floor_transitions.go; TestShaderConstantsMatchGo keeps
// the values equal.
const (
	floorBlendHard = 0
	floorBlendNatural = 1
	floorBlendWater = 2
	floorBlendCliffEast = 3
	floorBlendCliffWest = 4
	floorBlendVoid = 5
	floorBlendChasm = 6
	floorProfileModulus = 8
	floorWaterGroupEdge = 8
	floorSurfWater = 16
	floorFrozenWater = 32
	floorBlendBoundary = 64
	floorBlendShore = 128
)

// Boundary bands, in tiles from the shared tile edge to each side.
const floorBandNatural = 0.24 // grass, sand, soil against each other
const floorBandNarrow = 0.09 // cliff and void pairings; variants of one water, ice against water
const floorBandShore = 0.02 // the waterline: about one texel
const floorBandDepth = 0.5 // two water groups (shallow and deep): one gradient from tile centre to tile centre
const floorBankRound = 0.22 // radius of the arc a bank turns a tile corner on
const floorBandWobble = 0.025 // how far noise moves a land boundary; water edges stay straight

// Surf on lakes and seas (map water_bodies), in tiles. How fast crests travel is set in
// render_floor_transitions.go.
const floorSurfReach = 1.7 // how far from the bank waves show
const floorSurfSpacing = 0.55 // distance between crests
// The surf clock (SurfClock, in crests) wraps at this count; crests are hashed
// modulo it so the wrap is seamless. Repeats the Go constant.
const floorSurfWaveCycle = 64
const floorSurfBend = 0.6 // how far noise bends a crest line, in spacings
const floorSurfLine = 0.07 // width of a crest line, in spacings
const floorSurfFoam = 0.75 // strength of a crest at the bank

var CamPos vec2
var DirCos float
var DirSin float
var PlaneCos float
var PlaneSin float
var ScreenSize vec2
var Horizon float
var RowDistFactor float
var TileSize float
var WorldSize vec2
var ViewDist float
var MinBrightness float
var Ambient float
var ViewerAmbient float
var TexCount float
var TexTileSize vec2
var MaxMip float
var SurfClock float
var LightCount float
var Lights [32]vec4
var HeatCount float
var Heat [8]vec4 // fire cells: x, y, radius, strength

// sampleFloorMip does one sharp-bilinear tap inside a texture's atlas cell at
// the given mip level. Level k's strip starts at y = TexH*2*(1-0.5^k) with
// cells scaled by 0.5^k; texel lookups clamp inside the authored cell.
// Neighboring materials are blended explicitly. The sharpen factor squeezes
// magnification interpolation into a ~1px band at texel seams; it only
// applies at level 0 - minified levels use plain bilinear.
func sampleFloorMip(atlasIndex, lx, ly, level, texelsPerPixel float) vec4 {
	scale := pow(0.5, level)
	cw := TexTileSize.x * scale
	ch := TexTileSize.y * scale
	yOff := TexTileSize.y * 2.0 * (1.0 - scale)
	fx := lx*cw - 0.5
	fy := ly*ch - 0.5
	bx := floor(fx)
	by := floor(fy)
	sharp := 1.0
	if level < 0.5 && texelsPerPixel < 1.0 {
		sharp = 1.0 / texelsPerPixel
	}
	fracX := clamp((fx-bx-0.5)*sharp+0.5, 0.0, 1.0)
	fracY := clamp((fy-by-0.5)*sharp+0.5, 0.0, 1.0)
	x0 := clamp(bx, 0.0, cw-1.0)
	x1 := clamp(bx+1.0, 0.0, cw-1.0)
	y0 := clamp(by, 0.0, ch-1.0)
	y1 := clamp(by+1.0, 0.0, ch-1.0)
	cellX := atlasIndex * cw
	// imageSrcNUnsafeAt for N>=1 expects coordinates in source-0 texture
	// space; Ebitengine converts them to the target source internally.
	base := imageSrc0Origin()
	c00 := imageSrc1UnsafeAt(base + vec2(cellX+x0+0.5, yOff+y0+0.5))
	c10 := imageSrc1UnsafeAt(base + vec2(cellX+x1+0.5, yOff+y0+0.5))
	c01 := imageSrc1UnsafeAt(base + vec2(cellX+x0+0.5, yOff+y1+0.5))
	c11 := imageSrc1UnsafeAt(base + vec2(cellX+x1+0.5, yOff+y1+0.5))
	return mix(mix(c00, c10, fracX), mix(c01, c11, fracX), fracY)
}

// sampleFloorTrilinear blends the two mip levels bracketing mip.
func sampleFloorTrilinear(atlasIndex, lx, ly, mip, texelsPerPixel float) vec4 {
	k0 := floor(mip)
	k1 := min(k0+1.0, MaxMip)
	lo := sampleFloorMip(atlasIndex, lx, ly, k0, texelsPerPixel)
	blend := fract(mip)
	if blend == 0.0 || k0 == k1 {
		return lo
	}
	return mix(lo, sampleFloorMip(atlasIndex, lx, ly, k1, texelsPerPixel), blend)
}

// Stable value noise in tile coordinates. It never uses time or screen pixels.
func floorHash(p vec2) float {
	v := fract(vec3(p.x, p.y, p.x) * 0.1031)
	v += dot(v, v.yzx + 33.33)
	return fract((v.x + v.y) * v.z)
}

func floorNoise(p vec2) float {
	b := floor(p)
	f := fract(p)
	f = f*f*(3.0-2.0*f)
	return mix(mix(floorHash(b), floorHash(b+vec2(1,0)), f.x), mix(floorHash(b+vec2(0,1)), floorHash(b+vec2(1,1)), f.x), f.y)
}

func floorMaterialAt(tile vec2) vec4 {
	if tile.x<0 || tile.y<0 || tile.x>=WorldSize.x || tile.y>=WorldSize.y { return vec4(0) }
	raw := floor(imageSrc2UnsafeAt(imageSrc0Origin()+tile+vec2(0.5)).rgb*255.0+0.5)
	return vec4(raw.rg,mod(raw.b,floorProfileModulus),raw.b)
}

// Profile IDs match floorProfileByte. A directed cliff accepts only its
// solid, world-aligned side. Void never mixes with land, water, or bridges.
func floorCanBlend(a,b vec4, delta vec2) bool {
	if a.b==floorBlendHard || b.b==floorBlendHard { return false }
	if a.b==floorBlendChasm || b.b==floorBlendChasm { return false }
	if a.b==floorBlendVoid || b.b==floorBlendVoid { return a.b==floorBlendVoid && b.b==floorBlendVoid }
	if a.b==floorBlendCliffEast || a.b==floorBlendCliffWest {
		d := delta
		return b.b==floorBlendNatural && d.y==0 && ((a.b==floorBlendCliffEast && d.x == -1) || (a.b==floorBlendCliffWest && d.x == 1))
	}
	if b.b==floorBlendCliffEast || b.b==floorBlendCliffWest {
		d := -delta
		return a.b==floorBlendNatural && d.y==0 && ((b.b==floorBlendCliffEast && d.x == -1) || (b.b==floorBlendCliffWest && d.x == 1))
	}
	return true
}

// floorShoreDistance is the distance to water (x) and to the bank (y), in tiles.
func floorShoreDistance(q vec2) vec2 {
	p := clamp(q,vec2(0),WorldSize)
	b := floor(p)
	f := fract(p)
	a := imageSrc0Origin()+b+vec2(0.5)
	// CPU samples sit on map vertices. Clamp the last vertex at map edges.
	ox := min(1.0,WorldSize.x-b.x)
	oy := min(1.0,WorldSize.y-b.y)
	lo := mix(imageSrc3UnsafeAt(a).rg,imageSrc3UnsafeAt(a+vec2(ox,0)).rg,f.x)
	hi := mix(imageSrc3UnsafeAt(a+vec2(0,oy)).rg,imageSrc3UnsafeAt(a+vec2(ox,oy)).rg,f.x)
	return mix(lo,hi,f.y)*2.0
}

// floorWaterGroupsMeet reports whether two water groups meet at a tile corner
// (the shore map's B, one sample per map vertex).
func floorWaterGroupsMeet(vertex vec2) bool {
	mark := imageSrc3UnsafeAt(imageSrc0Origin()+clamp(vertex,vec2(0),WorldSize)+vec2(0.5)).b
	return mark>0.5
}

// floorSurfShare is 1 for a cell that shows surf: lake or sea water near a
// bank, not frozen.
func floorSurfShare(c vec4) float {
	if mod(floor(c.a/floorSurfWater),2.0)>0.5 && mod(floor(c.a/floorFrozenWater),2.0)<0.5 { return 1.0 }
	return 0.0
}

// floorSurf draws breaking waves over lake or sea water near a bank: crests running
// in, each a crisp line with flecks of foam trailing behind it. Nothing
// outlines the bank itself. Everything is cut on the texture's own pixel grid
// and anchored in world space; only the phase moves.
func floorSurf(rgb vec3, q vec2, maskFootprint float) vec3 {
	cell := floor(q*TexTileSize)
	texel := (cell+vec2(0.5))/TexTileSize
	bank := floorShoreDistance(texel).y
	if bank>=floorSurfReach { return rgb }
	detail := 1.0-smoothstep(0.05,0.20,maskFootprint)
	bend := floorNoise(texel*0.7)
	phase := bank/floorSurfSpacing+SurfClock+bend*floorSurfBend
	wave := mod(floor(phase),floorSurfWaveCycle)
	s := fract(phase)
	line := 1.0-step(floorSurfLine,s)
	// Behind the line the foam thins into clumps a few texels across.
	fleck := step(1.0-(1.0-smoothstep(floorSurfLine,0.5,s))*0.6,floorNoise(cell*0.31+vec2(wave*17.0,wave*29.0)))
	// Each wave is broken into runs of its own, so the gaps travel with it.
	run := step(0.42,floorNoise(texel*1.3+vec2(wave*13.1,wave*7.7)))
	near := 1.0-smoothstep(0.2,floorSurfReach,bank)
	crest := max(line,fleck*0.7)*run*mix(0.25,floorSurfFoam,near)*detail
	return mix(rgb,vec3(0.90,0.95,0.96),crest)
}

func floorCellColor(q,tile vec2, material vec4, mip,texelsPerPixel,waterDistance,noise float) vec3 {
	// Clamp neighbors to their OWN border. Wrapping here would pull a cliff's
	// dark drop edge onto the opposite, landward side of the authored artwork.
	return floorCellSample(q,tile,clamp(q-tile,vec2(0),vec2(1)),material,mip,texelsPerPixel,waterDistance,noise)
}

// floorCellSample is a cell's material at q, read at local within its texture.
func floorCellSample(q,tile,local vec2, material vec4, mip,texelsPerPixel,waterDistance,noise float) vec3 {
	base := imageSrc0UnsafeAt(imageSrc0Origin()+tile+vec2(0.5)).rgb
	if material.r>0 && material.r<=TexCount {
		base = sampleFloorTrilinear(material.r-1,local.x,local.y,mip,texelsPerPixel).rgb*0.8+base*0.2
	}
	if material.g>0 && material.g<=TexCount && waterDistance<1.6 {
		weight := 1.0-smoothstep(0.54,0.86,waterDistance+noise*0.10)
		if weight>0 {
			shore := sampleFloorTrilinear(material.g-1,local.x,local.y,mip,texelsPerPixel).rgb
			base = mix(base,shore,weight*0.95)
		}
	}
	if material.b==floorBlendNatural {
		base *= 1.0-0.18*(1.0-smoothstep(0.0,0.25,waterDistance))
	}
	if mod(floor(material.a/floorFrozenWater),2.0)>0.0 {
		// World-fixed frost and branching seams: no screen-space sliding or
		// extra layer above actors. The normal floor depth/lighting still applies.
		p := q*3.1
		bend := floorNoise(p*.73)*1.8
		branch := abs(sin(p.y*1.8-p.x*.43+bend*.8))
		branch += smoothstep(.30,.64,floorNoise(p*.39))*.45
		seam := min(abs(sin(p.x+p.y*.71+bend)),branch)
		width := max(.035,texelsPerPixel/max(TexTileSize.x,1.0)*3.1)
		crack := 1.0-smoothstep(0.0,width,seam)
		frost := .5+.5*sin(p.x*1.7+p.y*2.3)
		base = mix(base,vec3(.34,.65,.78),.78)
		base += vec3(.19,.24,.25)*(crack*.8+frost*.2)
	}
	return base
}

// Chasm lips belong only to exposed banks. Adjacent chasm cells remain one
// continuous opening, with no painted frame across the middle of a long gap.
// Everything stays in world coordinates; walking and spell rules are unchanged.
func floorChasmSurface(q,owner vec2,own vec4,mip,texelsPerPixel,maskFootprint float) vec3 {
	local := q-owner
	edge := 1.0
	bank := owner
	for i:=0;i<4;i++ {
		delta := vec2(-1,0)
		distance := local.x
		if i==1 { delta=vec2(1,0); distance=1.0-local.x }
		if i==2 { delta=vec2(0,-1); distance=local.y }
		if i==3 { delta=vec2(0,1); distance=1.0-local.y }
		neighbor := owner+delta
		if neighbor.x<0 || neighbor.y<0 || neighbor.x>=WorldSize.x || neighbor.y>=WorldSize.y { continue }
		if floorMaterialAt(neighbor).b!=floorBlendChasm && distance<edge { edge=distance; bank=neighbor }
	}
	depth := floorCellColor(q,owner,own,mip,texelsPerPixel,2.0,0)
	if edge==1.0 { return depth }
	// Small fixed chips break the lip, fading out at minification. They never
	// extend a walkable-looking ledge into the middle of the jump corridor.
	detail := 1.0-smoothstep(0.04,0.18,maskFootprint)
	d := max(0.0,edge+(floorNoise(q*18.0)-0.5)*0.025*detail)
	bankColor := floorCellColor(q,bank,floorMaterialAt(bank),mip,texelsPerPixel,2.0,0)
	filterWidth := max(0.002,min(0.035,maskFootprint*0.5))
	face := bankColor*mix(0.16,0.5,1.0-smoothstep(0.04,0.17,d))
	interior := mix(face,depth,smoothstep(0.17-filterWidth,0.17+filterWidth,d))
	lip := 1.0-smoothstep(0.035-filterWidth,0.035+filterWidth,d)
	return mix(interior,bankColor*0.9,lip)
}

func floorSurface(q vec2,mip,texelsPerPixel,maskFootprint float,noise vec2) vec3 {
	owner := floor(q)
	if owner.x<0 || owner.y<0 || owner.x>=WorldSize.x || owner.y>=WorldSize.y { return vec3(30.0/255.0) }
	own := floorMaterialAt(owner)
	if own.b==floorBlendChasm { return floorChasmSurface(q,owner,own,mip,texelsPerPixel,maskFootprint) }
	if own.b==floorBlendHard { return floorCellColor(q,owner,own,mip,texelsPerPixel,2.0,0) }
	shore := vec2(2.0)
	if own.a>=floorBlendShore { shore = floorShoreDistance(q) }
	ground := floorGround(q,owner,own,mip,texelsPerPixel,maskFootprint,shore.x,noise)
	surf := ground.a
	if surf>0 { return mix(ground.rgb,floorSurf(ground.rgb,q,maskFootprint),surf) }
	return ground.rgb
}

// floorGround is the ground at q: its own material, or the blend of the four
// cells around the nearest tile corner on a boundary tile. Alpha is the share
// of surf water shown there (floorSurfShare), whichever tile owns the pixel.
func floorGround(q,owner vec2,own vec4,mip,texelsPerPixel,maskFootprint,waterDistance float,noise vec2) vec4 {
	wet := floorSurfShare(own)
	if mod(floor(own.a/floorBlendBoundary),2.0)<0.5 { return vec4(floorCellColor(q,owner,own,mip,texelsPerPixel,waterDistance,noise.x),wet) }
	edgeDistance := min(fract(q),vec2(1)-fract(q))
	// The gradient between two water groups reaches the tile centre, so a tile
	// with such a corner always takes the four-cell path.
	groupEdge := own.b==floorBlendWater && mod(floor(own.a/floorWaterGroupEdge),2.0)>0.5
	if !groupEdge && min(edgeDistance.x,edgeDistance.y)>min(0.5,0.31+maskFootprint*0.5) {
		return vec4(floorCellColor(q,owner,own,mip,texelsPerPixel,waterDistance,noise.x),wet)
	}
	base := floor(q-vec2(0.5))
	fraction := q-vec2(0.5)-base
	var cells [4]vec4
	cells[0]=floorMaterialAt(base)
	cells[1]=floorMaterialAt(base+vec2(1,0))
	cells[2]=floorMaterialAt(base+vec2(0,1))
	cells[3]=floorMaterialAt(base+vec2(1,1))
	// A waterline is a crisp straight edge; two water groups meet in a smooth
	// gradient; every other pairing keeps its band.
	width := floorBandNatural
	wobble := floorBandWobble
	water, land, other := false, false, false
	frozen, open := false, false
	for i:=0;i<4;i++ {
		if cells[i].b==floorBlendWater {
			water = true
			if mod(floor(cells[i].a/floorFrozenWater),2.0)>0.5 { frozen = true } else { open = true }
		} else if cells[i].b==floorBlendNatural { land = true } else if cells[i].b!=floorBlendHard { other = true }
	}
	depth := water && !land && !other
	// Water cells blend in one gradient only where two groups meet; variants
	// of one water and ice against open water keep a crisp narrow band.
	waterBand := floorBandNarrow
	if water && !(frozen && open) && floorWaterGroupsMeet(base+vec2(1)) { waterBand = floorBandDepth }
	waterBand = min(0.48,waterBand+maskFootprint*0.5)
	detail := 1.0-smoothstep(0.06,0.24,maskFootprint)
	if water && land && !other {
		// A bank of plain land and water turns its corners on a curve. A hard
		// or unblended cell in the four keeps the square path below.
		round := true
		for i:=0;i<4;i++ {
			if cells[i].b==floorBlendHard || mod(floor(cells[i].a/floorBlendBoundary),2.0)<0.5 { round = false }
		}
		if round { return floorRoundBank(q,base,fraction,cells,own.b==floorBlendNatural,waterBand,mip,texelsPerPixel,maskFootprint,waterDistance,noise*detail) }
	}
	if other { width = floorBandNarrow } else if water && land { width, wobble = floorBandShore, 0.0 }
	// Filter the mask as well as the textures at distance. Near-field noise
	// perturbs only the narrow transition; interiors keep their original art.
	width = min(0.48,width+maskFootprint*0.5)
	if depth { width, wobble = waterBand, 0.0 }
	f := smoothstep(vec2(0.5-width),vec2(0.5+width),fraction+noise*wobble*detail)
	var rgb vec3
	total, surf := 0.0, 0.0
	for i:=0;i<4;i++ {
		offset := vec2(float(i%2),float(i/2))
		tile := base+offset
		weight := mix(1.0-f.x,f.x,offset.x)*mix(1.0-f.y,f.y,offset.y)
		if weight<=0 || tile.x<0 || tile.y<0 || tile.x>=WorldSize.x || tile.y>=WorldSize.y { continue }
		if tile!=owner {
			// The neighbor must opt in too: the outer edge of a cached boundary
			// band must not half-blend into a tile using the single-material path.
			if mod(floor(cells[i].a/floorBlendBoundary),2.0)<0.5 || !floorCanBlend(own,cells[i],tile-owner) { continue }
		}
		if depth {
			// Water textures tile on across the gradient: no edge pixel is stretched.
			rgb += floorCellSample(q,tile,fract(q-tile),cells[i],mip,texelsPerPixel,waterDistance,noise.x*detail)*weight
		} else {
			rgb += floorCellColor(q,tile,cells[i],mip,texelsPerPixel,waterDistance,noise.x*detail)*weight
		}
		total += weight
		surf += weight*floorSurfShare(cells[i])
	}
	if total>0 { return vec4(rgb/total,surf/total) }
	return vec4(floorCellColor(q,owner,own,mip,texelsPerPixel,waterDistance,noise.x*detail),wet)
}

// floorCornerInside is the distance into cell i's quadrant with its corner at
// the shared tile corner cut on a circle of radius floorBankRound; p is the
// offset from that tile corner. Positive inside.
func floorCornerInside(p vec2, i int) float {
	side := vec2(float(i%2),float(i/2))*2.0-vec2(1.0)
	a := vec2(floorBankRound)-p*side
	return floorBankRound-length(max(a,vec2(0)))-min(max(a.x,a.y),0.0)
}

// floorRoundBank draws the four cells around a tile corner as land and water
// split by one line. A straight bank stays on the tile edge; where one cell
// stands alone against the other three, its corner turns on a circular arc,
// convex or concave alike. Land blends with land and water with water under
// the mask. Textures tile on past their own tiles instead of stretching their
// edge pixels.
func floorRoundBank(q,base,fraction vec2,cells [4]vec4,ownLand bool,waterBand,mip,texelsPerPixel,maskFootprint,waterDistance float,noise vec2) vec4 {
	landBand := min(0.48,floorBandNatural+maskFootprint*0.5)
	fl := smoothstep(vec2(0.5-landBand),vec2(0.5+landBand),fraction+noise*floorBandWobble)
	fw := smoothstep(vec2(0.5-waterBand),vec2(0.5+waterBand),fraction)
	p := fraction-vec2(0.5)
	// Land is read from cells[i] each time: a local array written at a loop
	// index makes FXC unroll the caller's loops (TestShadersWriteNoElementAtAComputedIndex).
	count := 0
	for i:=0;i<4;i++ {
		if cells[i].b==floorBlendNatural { count++ }
	}
	land0 := cells[0].b==floorBlendNatural
	// inside is the distance into land.
	inside := 0.0
	if count==2 && land0==(cells[1].b==floorBlendNatural) {
		inside = p.y
		if land0 { inside = -p.y }
	} else if count==2 && land0==(cells[2].b==floorBlendNatural) {
		inside = p.x
		if land0 { inside = -p.x }
	} else {
		// One cell against three, or two land cells meeting at the corner only.
		inside = -1.0
		for i:=0;i<4;i++ {
			isLand := cells[i].b==floorBlendNatural
			if count==3 {
				if !isLand { inside = -floorCornerInside(p,i) }
			} else if isLand {
				inside = max(inside,floorCornerInside(p,i))
			}
		}
	}
	band := min(0.2,floorBandShore+maskFootprint*0.5)
	dry := smoothstep(-band,band,inside)
	var landRGB, waterRGB vec3
	landTotal, waterTotal, waterSurf := 0.0, 0.0, 0.0
	for i:=0;i<4;i++ {
		isLand := cells[i].b==floorBlendNatural
		offset := vec2(float(i%2),float(i/2))
		tile := base+offset
		if (isLand && dry<=0) || (!isLand && dry>=1) { continue }
		f := fw
		if isLand { f = fl }
		weight := mix(1.0-f.x,f.x,offset.x)*mix(1.0-f.y,f.y,offset.y)
		if weight<=0 { continue }
		// Water always tiles on; land does where the arc carries it past its
		// own tiles.
		local := clamp(q-tile,vec2(0),vec2(1))
		if !isLand || !ownLand { local = fract(q-tile) }
		cell := floorCellSample(q,tile,local,cells[i],mip,texelsPerPixel,waterDistance,noise.x)
		if isLand { landRGB += cell*weight; landTotal += weight } else { waterRGB += cell*weight; waterTotal += weight; waterSurf += weight*floorSurfShare(cells[i]) }
	}
	if landTotal<=0 { return vec4(waterRGB/max(waterTotal,0.0001),waterSurf/max(waterTotal,0.0001)) }
	if waterTotal<=0 { return vec4(landRGB/landTotal,0.0) }
	return vec4(mix(waterRGB/waterTotal,landRGB/landTotal,dry),(1.0-dry)*waterSurf/waterTotal)
}

func Fragment(rawDstPos vec4, srcPos vec2, color vec4) vec4 {
	dstPos := vec4(paniniSourcePoint(rawDstPos.xy-imageDstOrigin())+imageDstOrigin(),rawDstPos.zw)
	// Per-pixel sampling. (A legacy 2x2 block quantization matched the old CPU
	// floor loop; the floor is GPU-only now, so the half-resolution cost bought
	// nothing.)
	samplePx := dstPos.xy - imageDstOrigin()

	p := samplePx.y - Horizon
	if p < 0.5 {
		p = 0.5
	}
	rowDist := RowDistFactor / p

	t := samplePx.x / ScreenSize.x
	s := 2.0*t - 1.0
	floorX := CamPos.x + rowDist*DirCos + rowDist*PlaneCos*s
	floorY := CamPos.y + rowDist*DirSin + rowDist*PlaneSin*s

	// Keep the existing anisotropic three-tap footprint; each tap resolves its
	// own materials so a distant screen pixel integrates across tile boundaries.
	const tapCount = 3
	ray := vec2(DirCos,DirSin)+vec2(PlaneCos,PlaneSin)*s
	texelScale := TexTileSize/TileSize
	horizontal := vec2(PlaneCos,PlaneSin)*(rowDist*2.0/ScreenSize.x)*texelScale
 vertical := ray*(rowDist*rowDist/RowDistFactor)*texelScale
 tapStep := 1.0
 if WorldPanini.x > 0 {
  // Native Panini pixels follow curved rays. Perspective retains its smooth
  // analytical footprint rather than finite differences across 2x2 quads.
  worldPos := vec2(floorX, floorY)
  horizontal = dfdx(worldPos)*texelScale
  vertical = dfdy(worldPos)*texelScale
  tapStep = dfdy(samplePx.y)
 }
	texelsPerPixel := max(length(horizontal),0.0001)
	foot := max(texelsPerPixel,length(vertical)/float(tapCount))
	mip := clamp(log2(max(foot,1.0)),0.0,MaxMip)
	maskFootprint := foot/max(TexTileSize.x,1.0)
	q := vec2(floorX,floorY)/TileSize
	var noise vec2
	if floorMaterialAt(floor(q)).a>=floorBlendBoundary { // boundary or shore bit
		noise = vec2(floorNoise(q*1.5),floorNoise(q*1.5+vec2(17,41)))*2.0-1.0
	}
	var rgb vec3
	for tap:=0;tap<tapCount;tap++ {
		offset := (float(tap)+0.5)/float(tapCount)-0.5
		tapDist := RowDistFactor/(p+offset*tapStep)
		rgb += floorSurface((CamPos+tapDist*ray)/TileSize,mip,texelsPerPixel,maskFootprint,noise)
	}
	rgb /= float(tapCount)

	dx := floorX - CamPos.x
	dy := floorY - CamPos.y
	dist := sqrt(dx*dx + dy*dy)
	brightness := 1.0 - dist/ViewDist
	if brightness < MinBrightness {
		brightness = MinBrightness
	}
	// Map ambient level: dark maps stay dark until point lights lift them.
	localAmbient := Ambient
	if ViewerAmbient > 0.0 && ViewerAmbient < localAmbient {
		localAmbient = ViewerAmbient
	}
	brightness *= localAmbient
	for i := 0; i < 32; i++ {
		if float(i) >= LightCount {
			break
		}
		L := Lights[i]
		ldx := floorX - L.x
		ldy := floorY - L.y
		// Squared-distance early-out: most pixels are outside most lights, and
		// an unconditional sqrt per light per pixel was the frame-rate cost of
		// torch-lined maps.
		d2 := ldx*ldx + ldy*ldy
		if d2 < L.z*L.z {
			falloff := 1.0 - sqrt(d2)/L.z
			brightness += L.w * falloff
		}
	}
	if brightness > 1.0 {
		brightness = 1.0
	}
	// Fire zones throw a warm glow on the ground around them, added over the
	// lighting so it reads by day as well as in the dark.
	heat := 0.0
	for i := 0; i < 8; i++ {
		if float(i) >= HeatCount {
			break
		}
		H := Heat[i]
		hdx := floorX - H.x
		hdy := floorY - H.y
		h2 := hdx*hdx + hdy*hdy
		if h2 < H.z*H.z {
			f := 1.0 - sqrt(h2)/H.z
			heat += H.w * f * f
		}
	}
	return vec4(min(rgb*brightness+vec3(1.0, 0.46, 0.12)*min(heat, 0.7), vec3(1.0)), 1.0)
}

//include panini.kageinc
