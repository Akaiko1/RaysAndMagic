//kage:unit pixels
package main

//include weapon_noise.kageinc

// Two broad noise scales keep the silhouette readable at projectile size.
func spellFlow(p vec2) float {
	return fxNoise(p)*0.68 + fxNoise(p*2.13+7.4)*0.32
}

// Unequal planar cuts, broad shaded facets and fine mineral grain.
func stoneFace(p vec2, seed float) vec2 {
	edge := -10.0
	for i := 0; i < 7; i++ {
		a := float(i)*0.8976 + 0.17*sin(float(i)*2.3+seed)
		plane := dot(p, vec2(cos(a), sin(a))) - (0.67 + 0.12*sin(float(i)*3.7+seed))
		edge = max(edge, plane)
	}
	mask := 1.0 - smoothstep(-0.015, 0.025, edge)
	shade := 0.5
	if p.y < p.x*0.3-0.1 {
		shade = 0.95
	}
	if p.y > -p.x*0.8+0.05 {
		shade = 0.67
	}
	if p.x > 0.28+p.y*0.2 {
		shade = 0.32
	}
	seam := min(abs(p.y-p.x*0.3+0.1), abs(p.y+p.x*0.8-0.05))
	shade *= 0.72 + 0.28*smoothstep(0.008, 0.025, seam)
	shade += fxNoise(p*24.0+seed) * 0.14
	return vec2(mask, shade)
}

// Local coordinates are in projected body radii, not screen pixels.
// Custom carries animation time, stable seed, end-on view, and material ID.
func Fragment(dst vec4, p vec2, color vec4, custom vec4) vec4 {
	t, seed, head, kind := custom.x, custom.y, custom.z, floor(custom.w)
	n := spellFlow(p*2.4 + vec2(-t*1.7, seed+t*0.4))
	fine := fxNoise(p*7.0 + vec2(t, seed))
	q := p + vec2(n-0.5, fine-0.5)*0.18
	r := length(q)
	a, heat := 0.0, 0.0
	tint := color.rgb
	white := vec3(1.0, 0.96, 0.85)
	// Body and turbulent wake share one continuous density field.
	wake := smoothstep(-3.0, -0.3, q.x) * (1.0 - smoothstep(-0.2, 0.4, q.x))
	wake *= exp(-q.y*q.y*3.5) * (1.0 - head)
	if kind == 0.0 {
		// A round, red-orange rolling fire mass, with broad licking tongues.
		density := 1.0 - length(q*vec2(1.0, 1.08)) + (n-0.5)*0.55
		density = max(density, wake*(0.65+n*0.7)-0.38)
		a = smoothstep(-0.08, 0.14, density)
		heat = clamp(density*1.45+fine*0.17, 0.0, 1.0)
		tint = mix(vec3(0.3, 0.025, 0.004), vec3(1.0, 0.18, 0.01), smoothstep(0.0, 0.4, heat))
		tint = mix(tint, vec3(1.0, 0.68, 0.08), smoothstep(0.45, 0.9, heat))
	} else if kind == 1.0 || kind == 12.0 {
		// Lightning has branching, changing thickness, and a broad ionized glow.
		bolt, glow := 0.0, 0.0
		if head > 0.5 {
			for k := 0; k < 3; k++ {
				angle := float(k)*2.1 + seed
				axis := dot(p, vec2(cos(angle), sin(angle)))
				across := dot(p, vec2(-sin(angle), cos(angle)))
				jag := (fxNoise(vec2(axis*4.0, floor(t*16.0)+seed+float(k))) - 0.5) * 0.6 * abs(axis)
				d := abs(across - jag)
				span := 1.0 - smoothstep(0.3, 1.3, abs(axis))
				bolt += exp(-d*d*330.0) * span
				glow += exp(-d*d*16.0) * span * 0.22
			}
		} else {
			jag := (fxNoise(vec2(p.x*5.0, floor(t*16.0)+seed)) - 0.5) * 0.75
			d := abs(p.y - jag)
			fork := abs(p.y + jag*0.7 - 0.3*sin(p.x*4.0+t))
			span := 1.0 - smoothstep(1.0, 2.15, abs(p.x+0.5))
			bolt = (exp(-d*d*360.0) + exp(-fork*fork*180.0)*0.6) * span
			glow = exp(-d*d*12.0) * span * 0.36
		}
		if kind == 12.0 {
			bolt *= 0.4 + 0.6*smoothstep(0.25, 0.55, fine)
			glow *= 0.65
		}
		a = clamp(bolt+glow, 0.0, 1.0)
		tint = mix(color.rgb*0.55, white, clamp(bolt, 0.0, 1.0))

	} else if kind == 7.0 || kind == 8.0 {
		angle := t*1.1 + seed
		rp := vec2(p.x*cos(angle)-p.y*sin(angle), p.x*sin(angle)+p.y*cos(angle))
		if kind == 7.0 {
			rock := stoneFace(rp*vec2(0.88, 1.06), seed)
			a = rock.x
			tint = color.rgb * (0.55 + rock.y*0.8)
		} else {
			// Interlocked unequal granite chunks around a mossy core, not petals.
			for k := 0; k < 5; k++ {
				f := float(k)
				ang := f*2.4 + 0.3
				off := vec2(cos(ang), sin(ang)) * (0.35 + 0.08*sin(t*2.0+f))
				part := stoneFace((rp-off)*vec2(1.6+f*0.12, 1.2+f*0.16), seed+f*3.0)
				if part.x > a {
					a = part.x
					tint = mix(vec3(0.42, 0.36, 0.27), color.rgb, 0.3) * (0.6 + part.y)
				}
			}
			core := stoneFace(rp*2.2, seed+4.0)
			tint = mix(tint, color.rgb*(0.5+core.y), core.x)
			a = max(a, core.x)
		}
	} else if kind == 6.0 {
		// A long, straight luminous shaft with a narrow white core and soft falloff.
		span := smoothstep(-6.8, -4.7, p.x) * (1.0 - smoothstep(0.35, 0.8, p.x))
		beam := exp(-p.y*p.y*480.0) * span
		haze := exp(-p.y*p.y*21.0) * span * 0.34
		if head > 0.5 {
			beam = exp(-dot(p, p) * 170.0)
			haze = exp(-dot(p, p)*10.0) * 0.4
		}
		a = clamp(beam+haze, 0.0, 1.0)
		tint = mix(color.rgb, vec3(1.0, 1.0, 0.94), beam)
	} else if kind == 19.0 {
		// A brief eye-shaped flash: two tapered energy arcs, a broken iris flare,
		// and a bright centre. The surrounding space stays transparent.
		blink := 0.85 + 0.15*sin(t*8.0+seed)
		span := 1.0 - smoothstep(0.90, 1.22, abs(p.x))
		lid := 0.48 * max(0.0, 1.0-p.x*p.x) * blink
		band := abs(abs(p.y) - lid - (n-0.5)*0.035)
		rim := exp(-band*band*520.0) * span
		halo := exp(-band*band*45.0) * span * 0.28
		ir := length(p * vec2(1.0, 0.92))
		broken := 0.55 + 0.45*sin(atan2(p.y, p.x)*3.0+t*6.0)
		iris := exp(-pow((ir-0.23)*13.0, 2.0)) * broken
		flare := exp(-p.x*p.x*95.0 - p.y*p.y*13.0)
		a = clamp(rim*.85+halo+iris*.55+flare*.85, 0.0, 1.0)
		tint = mix(color.rgb*0.65, vec3(0.90, 1.0, 0.61), clamp(rim*.6+flare, 0.0, 1.0))
	} else if kind == 17.0 {
		// Psychic pressure folds inward around a bright travelling tear.
		core := exp(-p.y*p.y*24.0 - p.x*p.x*1.7)
		sheets := 0.0
		for k := 0; k < 3; k++ {
			f := float(k)
			wave := sin(p.x*2.5-t*4.0+f*1.7) * (0.2 + f*0.13)
			span := 1.0 - smoothstep(0.6, 1.65, abs(p.x+f*0.15))
			sheets += exp(-pow((p.y-wave)*5.0, 2.0)) * span * (0.3 + 0.2*n)
		}
		a = clamp(core*0.85+sheets, 0.0, 0.9)
		tint = mix(color.rgb*0.48, vec3(0.91, 0.84, 1.0), core) + color.rgb*sheets*0.22
	} else if kind == 4.0 || kind == 16.0 {
		// Radiance and bloom are filled lobes with a bright center, never wire rings.
		angle := atan2(q.y, q.x) + t*0.45
		radius := 0.58 + 0.3*cos(angle*5.0)
		if kind == 4.0 {
			radius = 0.25 + 0.75*pow(max(0.0, cos(angle*5.0)), 2.0)
		}
		a = 1.0 - smoothstep(radius-0.12, radius+0.09, r)
		heat = exp(-r * r * 6.0)
		tint = mix(color.rgb*(0.55+0.3*n), white, heat)
		if kind == 16.0 {
			tint = mix(color.rgb*0.65, vec3(1.0, 0.65, 0.8), heat+0.2*cos(angle*5.0))
		}
		a = max(a, wake*(0.18+0.25*n))
	} else if kind == 9.0 {
		// A compact, moving swarm: paired wings around seven dark bodies.
		for k := 0; k < 7; k++ {
			f := float(k)
			pos := vec2(sin(f*2.4+t*(0.7+f*0.05)), cos(f*3.7+t)) * 0.75
			b := p - pos
			wing := length(b*vec2(3.5, 7.0)) - 0.7 - 0.18*sin(t*35.0+f)
			bug := 1.0 - smoothstep(-0.15, 0.1, wing)
			a = max(a, bug)
		}
		tint = mix(color.rgb*0.14, color.rgb*0.8, fine)
	} else if kind == 15.0 {
		// Thick linked angular cuffs, with bright bevels and dark interiors.
		for k := 0; k < 3; k++ {
			f := float(k) - 1.0
			b := p - vec2(f*0.62, sin(t*2.0+f)*0.18)
			diamond := abs(b.x)*0.85 + abs(b.y)*1.1
			band := abs(diamond - 0.43)
			a = max(a, 1.0-smoothstep(0.09, 0.16, band))
		}
		tint = color.rgb*(0.6+0.4*n) + white*pow(fine, 6.0)*0.4
	} else if kind == 18.0 {
		// A muscular lashing sheet, tapering into a torn edge.
		bend := sin(p.x*2.3-t*5.0) * 0.4
		width := 0.15 + 0.22*(0.5+0.5*sin(p.x*1.4+t))
		d := abs(p.y-bend) + (n-0.5)*0.15
		span := 1.0 - smoothstep(0.6, 2.7, abs(p.x))
		if head > 0.5 {
			span = 1.0 - smoothstep(0.5, 1.45, abs(p.x))
		}
		a = (1.0 - smoothstep(width*0.7, width, d)) * span
		tint = mix(color.rgb*0.45, white, pow(max(0.0, 1.0-d/width), 3.0)*0.8)
	} else {
		// Blight, mind and void: opaque negative space with rolling membranes.
		curl := n + 0.24*sin(atan2(q.y, q.x)*3.0+r*6.0-t*3.0)
		if kind == 2.0 {
			curl = n + 0.1*sin(t*5.0)
			r = length(q * vec2(1.0, 0.9))
		}
		if kind == 13.0 {
			curl = spellFlow(p*2.8 + vec2(-t*2.0, seed))
			r = length(q * vec2(0.8, 1.2))
		}
		density := 0.85 - r + (curl-0.5)*0.42
		a = smoothstep(-0.12, 0.09, density)
		heat = smoothstep(0.25, 0.8, curl) * exp(-r*r*0.65)
		tint = mix(color.rgb*0.08, color.rgb, heat)
		if kind == 2.0 {
			tint = mix(color.rgb*0.16, vec3(0.68, 1.0, 0.34), heat*heat)
		}
		if kind == 3.0 {
			tint += vec3(0.45, 0.25, 0.8) * pow(heat, 4.0)
		}
		if kind == 5.0 {
			a *= smoothstep(0.2, 0.34, fine+density)
			tint += white * pow(heat, 5.0) * 0.7
		}
		a = max(a, wake*(0.3+0.3*n))
	}
	a *= min(1.0, color.a)
	return vec4(tint*a, a)
}
