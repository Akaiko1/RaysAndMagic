// Fire Aura enchants the actual golden sword. Back flame arcs render before
// the model and front arcs after it, so the vortex wraps its solid silhouette.
func castFlame(p vec2, t, fade float) vec4 {
	if abs(p.x)>.26 || p.y < -.40 || p.y>.40 {return vec4(0)}
	height:=.35-p.y
	axis:=.024-.10*(p.y+.29)
	light:=vec3(0)
	alpha:=float(0)
	for i:=0;i<3;i++ {
		seed:=float(i)*2.0944
		angle:=height*18-t*13+seed
		radius:=.075+.055*sin(clamp(height/.7,0,1)*3.14159)
		depth:=cos(angle)
		front:=smoothstep(-.16,.16,depth)
		weight:=front
		if Pass<0 {weight=1-front}
		if weight<=0 {continue}
		center:=axis+sin(angle)*radius
		flow:=vec2(p.x*2.9+seed*.2,height*1.8-t*.93)
		curl:=veilNoise(flow*.6+vec2(.1,.37))-.5
		n:=veilNoise(flow+curl*.25)
		fine:=veilNoise(flow*2.5+curl*.21).g
		width:=.030+.017*(1-depth*depth)
		distance:=abs(p.x-center+curl.x*.018)
		envelope:=exp(-distance*distance/(width*width))
		density:=envelope*(.5+n.g*.75+fine*.25)
		flame:=smoothstep(.22,.73,density)
		tip:=smoothstep(-.04,.09,height)*(1-smoothstep(.61,.76,height))
		hot:=smoothstep(.70,1.15,density)
		glow:=exp(-distance*42)*.10
		col:=mix(vec3(1,.08,.005),vec3(1,.48,.028),flame)
		col=mix(col,vec3(1,.95,.60),hot)
		a:=(flame*.84+glow)*tip*fade*weight
		col*=.72+.28*front
		light+=col*a*(1-alpha)
		alpha+=a*(1-alpha)
	}
	return vec4(min(light,vec3(alpha)),alpha)
}

func advancedCast(p vec2, t, fade, style float) vec4 {
	if style < 2.5 { return castFlame(p,t,fade) }
	if style==3 || style==7 {return kineticCast(p,t,fade,style)}
	if style==8 || style==15 || style==22 {return lifeCast(p,t,fade,style)}
	if style==16 || style==18 {return cleansingCast(p,t,fade,style)}
	if style==4 || style==9 || style==17 || style==21 || style==23 {return advancedWard(p,t,fade,style)}
	return vec4(0)
}
