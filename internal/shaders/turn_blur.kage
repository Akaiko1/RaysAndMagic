//kage:unit pixels

package main

// Yaw motion blur for the perspective view. Panini renders without this pass.
var BlurPx float

func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
 size := imageSrc0Size()
 origin := imageSrc0Origin()
 local := srcPos-origin
	sy := clamp(local.y, 0.5, size.y-0.5)

	const taps = 13
	sum := vec4(0.0)
	for i := 0; i < taps; i++ {
		t := (float(i)/float(taps-1))*2.0 - 1.0 // -1 .. +1
		sx := clamp(local.x+t*BlurPx, 0.5, size.x-0.5)
		sum += imageSrc0UnsafeAt(origin + vec2(sx, sy))
	}
	return (sum / float(taps)) * color
}
